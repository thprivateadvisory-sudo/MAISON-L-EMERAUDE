{%- comment -%} Carte produit (recherche, collections). Paramètre : item (produit ou résultat de recherche). {%- endcomment -%}
{%- if item.object_type == 'product' or item.variants -%}
  <a href="{{ item.url }}" style="display: flex; flex-direction: column; gap: 12px;">
    <div style="aspect-ratio: 4 / 5; overflow: hidden; background: #F3EEE3;">
      {% if item.featured_image %}
        <img
          src="{{ item.featured_image | image_url: width: 500 }}"
          srcset="{{ item.featured_image | image_url: width: 300 }} 300w, {{ item.featured_image | image_url: width: 500 }} 500w"
          sizes="(max-width: 860px) 50vw, 25vw"
          width="500"
          height="625"
          alt="{{ item.featured_image.alt | default: item.title | escape }}"
          loading="lazy"
          style="width: 100%; height: 100%; object-fit: cover;"
        >
      {% endif %}
    </div>
    <span class="serif" style="font-size: 18px; font-weight: 400; color: #17140F;">{{ item.title }}</span>
    <span class="sans" style="font-size: 13px; font-weight: 300; color: #4A463D;">{{ item.price | money }}</span>
  </a>
{%- else -%}
  <a href="{{ item.url }}" class="serif" style="font-size: 18px;">{{ item.title }}</a>
{%- endif -%}
