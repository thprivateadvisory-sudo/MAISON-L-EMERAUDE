<div class="sect" style="width: 100%; padding-bottom: 64px;">
  <div style="max-width: 1100px; margin: 0 auto; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 14px; margin-bottom: 60px;">
    <span class="eyebrow" style="color: #B08D57; font-size: 10.5px;">Votre commande, notre engagement</span>
    <span class="ornament"></span>
    <h3 class="serif" style="margin: 0; font-size: clamp(26px, 4vw, 34px); font-weight: 300; letter-spacing: -.005em;">Une pièce, une attention</h3>
  </div>
  <div class="grid-4" style="max-width: 1100px; margin: 0 auto;">
    <div style="display: flex; flex-direction: column; gap: 14px; text-align: center; align-items: center;">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#B08D57" stroke-width="1.2"><rect x="4" y="10" width="16" height="10" rx="1.5"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
      <div class="sans" style="font-size: 13px; font-weight: 300; letter-spacing: .03em; color: #17140F; line-height: 1.6;">Paiement sécurisé</div>
    </div>
    <div style="display: flex; flex-direction: column; gap: 14px; text-align: center; align-items: center;">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#B08D57" stroke-width="1.2"><path d="M3 7h11v10H3z"/><path d="M14 10h4l3 3v4h-7z"/><circle cx="7.5" cy="18.5" r="1.5"/><circle cx="17.5" cy="18.5" r="1.5"/></svg>
      <div class="sans" style="font-size: 13px; font-weight: 300; letter-spacing: .03em; color: #17140F; line-height: 1.6;">Expédition suivie<br><span style="color: #9c968a; font-size: 11.5px;">{{ section.settings.shipping_delay | default: "3 à 7 jours ouvrés" }}</span></div>
    </div>
    <div style="display: flex; flex-direction: column; gap: 14px; text-align: center; align-items: center;">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#B08D57" stroke-width="1.2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      <div class="sans" style="font-size: 13px; font-weight: 300; letter-spacing: .03em; color: #17140F; line-height: 1.6;">Service client disponible</div>
    </div>
    <div style="display: flex; flex-direction: column; gap: 14px; text-align: center; align-items: center;">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#B08D57" stroke-width="1.2"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/></svg>
      <div class="sans" style="font-size: 13px; font-weight: 300; letter-spacing: .03em; color: #17140F; line-height: 1.6;">Retours<br><span style="color: #9c968a; font-size: 11.5px;">{{ section.settings.return_policy | default: "30 jours après réception" }}</span></div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Réassurance",
  "settings": [
    { "type": "text", "id": "shipping_delay", "label": "Délai de livraison" },
    { "type": "text", "id": "return_policy", "label": "Politique de retour" }
  ]
}
{% endschema %}
