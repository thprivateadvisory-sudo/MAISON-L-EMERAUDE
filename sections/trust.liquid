<div class="sect" style="width: 100%; padding-top: clamp(48px, 7vw, 80px); padding-bottom: clamp(48px, 7vw, 80px);">
  <div style="max-width: 1100px; margin: 0 auto;">

    <div class="grid-4" style="align-items: start;">

      <div style="display: flex; flex-direction: column; gap: 16px; align-items: center; text-align: center;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#B08D57" stroke-width="1.3">
          <rect x="4" y="10" width="16" height="10" rx="1.5"/>
          <path d="M8 10V7a4 4 0 0 1 8 0v3"/>
        </svg>
        <div>
          <div class="sans" style="font-size: 12px; font-weight: 400; letter-spacing: .06em; color: #17140F; margin-bottom: 4px;">Paiement sécurisé</div>
          <div class="sans" style="font-size: 11.5px; font-weight: 300; color: #9c968a; line-height: 1.5;">Transactions cryptées et protégées</div>
        </div>
      </div>

      <div style="display: flex; flex-direction: column; gap: 16px; align-items: center; text-align: center;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#B08D57" stroke-width="1.3">
          <path d="M3 7h11v10H3z"/>
          <path d="M14 10h4l3 3v4h-7z"/>
          <circle cx="7.5" cy="18.5" r="1.5"/>
          <circle cx="17.5" cy="18.5" r="1.5"/>
        </svg>
        <div>
          <div class="sans" style="font-size: 12px; font-weight: 400; letter-spacing: .06em; color: #17140F; margin-bottom: 4px;">Expédition suivie</div>
          <div class="sans" style="font-size: 11.5px; font-weight: 300; color: #9c968a; line-height: 1.5;">{{ section.settings.shipping_delay | default: "3 à 7 jours ouvrés" }} · numéro de suivi inclus</div>
        </div>
      </div>

      <div style="display: flex; flex-direction: column; gap: 16px; align-items: center; text-align: center;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#B08D57" stroke-width="1.3">
          <path d="M3 12a9 9 0 1 0 3-6.7"/>
          <path d="M3 4v5h5"/>
        </svg>
        <div>
          <div class="sans" style="font-size: 12px; font-weight: 400; letter-spacing: .06em; color: #17140F; margin-bottom: 4px;">Retours 30 jours</div>
          <div class="sans" style="font-size: 11.5px; font-weight: 300; color: #9c968a; line-height: 1.5;">{{ section.settings.return_policy | default: "Retour simple, à partir de la réception" }}</div>
        </div>
      </div>

      <div style="display: flex; flex-direction: column; gap: 16px; align-items: center; text-align: center;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#B08D57" stroke-width="1.3">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
        </svg>
        <div>
          <div class="sans" style="font-size: 12px; font-weight: 400; letter-spacing: .06em; color: #17140F; margin-bottom: 4px;">Service client</div>
          <div class="sans" style="font-size: 11.5px; font-weight: 300; color: #9c968a; line-height: 1.5;">Réponse sous 24 à 48h ouvrées</div>
        </div>
      </div>

    </div>

  </div>
</div>

{% schema %}
{
  "name": "Réassurance",
  "settings": [
    { "type": "text", "id": "shipping_delay", "label": "Délai de livraison", "default": "3 à 7 jours ouvrés" },
    { "type": "text", "id": "return_policy", "label": "Politique de retour", "default": "Retour simple, à partir de la réception" }
  ]
}
{% endschema %}
