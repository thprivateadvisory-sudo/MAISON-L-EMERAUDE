<div class="sect" style="width: 100%; min-height: 50vh;">
  <div style="max-width: 860px; margin: 0 auto;">

    <h1 class="serif" style="font-size: clamp(26px, 4.5vw, 34px); font-weight: 300; margin-bottom: 40px; letter-spacing: -.005em;">Votre panier</h1>

    {% if cart.item_count == 0 %}
      <div style="display: flex; flex-direction: column; gap: 20px; align-items: flex-start; padding: clamp(40px, 6vw, 60px) 0;">
        <p class="sans" style="color: #4A463D; font-size: 14px; font-weight: 300; line-height: 1.7; margin: 0;">Votre panier est vide pour l'instant.</p>
        <a href="{{ routes.root_url }}#collection" class="btn">Découvrir la collection</a>
      </div>

    {% else %}

      {%- liquid
        # Code parure appliqué ? Il n'est pas cumulable avec l'offre de lancement
        assign bundle_applied = false
        assign trio_applied = false
        assign bundle_code = settings.bundle_discount_code | strip | upcase
        assign trio_code = settings.trio_discount_code | strip | upcase
        for app in cart.discount_applications
          assign app_title = app.title | upcase
          if bundle_code != blank and app_title == bundle_code
            assign bundle_applied = true
          elsif trio_code != blank and app_title == trio_code
            assign trio_applied = true
          endif
        endfor
      -%}
      {% if trio_applied %}
      <div class="offer-box" style="margin-bottom: 32px;">
        <span class="offer-box-title">Parure complète appliquée</span>
        <p class="offer-box-content" style="margin: 0;">Le collier, les boucles d'oreilles et le bracelet bénéficient de la remise parure ({{ settings.trio_percent }} %). Elle est déjà déduite du total ci-dessous.</p>
      </div>
      {% elsif bundle_applied %}
      {% # Rappel offre parure %}
      <div class="offer-box" style="margin-bottom: 32px;">
        <span class="offer-box-title">Offre parure appliquée</span>
        <p class="offer-box-content" style="margin: 0;">Le collier et les boucles d'oreilles vous sont proposés au prix de la parure. La remise est déjà déduite du total ci-dessous.</p>
      </div>
      {% elsif settings.offer_active %}
      {% # Rappel offre 1+1 %}
      <div class="offer-box" style="margin-bottom: 32px;">
        <span class="offer-box-title">Offre de lancement incluse</span>
        <p class="offer-box-content" style="margin: 0;">Une seconde pièce identique est offerte avec votre commande. Vous recevrez deux bijoux, chacun dans son écrin, dans le même colis.{% if settings.offer_end_date != blank %} Offre valable jusqu'au {{ settings.offer_end_date }} inclus.{% endif %}</p>
      </div>
      {% endif %}

      {% form 'cart', cart %}
        <ul class="cart-lines">
          {% for item in cart.items %}
            <li class="cart-line">
              <a href="{{ item.url }}" class="cart-line-img">
                {% if item.image %}
                  <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.image.alt | default: item.product.title | escape }}" width="88" height="88" loading="lazy">
                {% endif %}
              </a>

              <div class="cart-line-info">
                <a href="{{ item.url }}" class="cart-line-title">{{ item.product.title }}</a>
                {% unless item.product.has_only_default_variant %}
                  <span class="cart-line-variant">{{ item.variant.title }}</span>
                {% endunless %}
                {% for discount in item.line_level_discount_allocations %}
                  {% if discount.amount > 0 %}<span class="cart-line-discount">{{ discount.discount_application.title }} (−{{ discount.amount | money }})</span>{% endif %}
                {% endfor %}

                <div class="cart-line-actions">
                  <div class="cart-qty" role="group" aria-label="Quantité — {{ item.product.title | escape }}">
                    <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&amp;quantity={{ item.quantity | minus: 1 }}" class="cart-qty-btn" aria-label="Retirer un exemplaire">−</a>
                    <span class="cart-qty-value" aria-live="polite">{{ item.quantity }}</span>
                    <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&amp;quantity={{ item.quantity | plus: 1 }}" class="cart-qty-btn" aria-label="Ajouter un exemplaire">+</a>
                  </div>
                  <a href="{{ item.url_to_remove }}" class="cart-remove" aria-label="Supprimer {{ item.product.title | escape }} du panier">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14"/></svg>
                    Supprimer
                  </a>
                </div>
              </div>

              <div class="cart-line-price">
                {% if item.original_line_price > item.final_line_price %}<s><span class="visually-hidden">Prix avant remise :</span>{{ item.original_line_price | money }}</s>{% endif %}
                <span>{% if item.final_line_price == 0 %}Offert{% else %}{{ item.final_line_price | money }}{% endif %}</span>
              </div>
            </li>
          {% endfor %}
        </ul>

        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 24px; flex-wrap: wrap; gap: 16px; padding-top: 20px; border-top: 1px solid rgba(27,24,18,.1);">
          <a href="{{ routes.root_url }}#collection" class="u-link sans" style="font-size: 11px; letter-spacing: .08em; color: #4A463D;">← Continuer mes achats</a>
          <div style="text-align: right;">
            {% for discount in cart.cart_level_discount_applications %}
              <div class="sans" style="font-size: 12px; font-weight: 400; color: #7A5C2E; margin-bottom: 6px;">{{ discount.title }} : −{{ discount.total_allocated_amount | money }}</div>
            {% endfor %}
            <div class="serif" style="font-size: 22px; font-weight: 400; color: #17140F; letter-spacing: .02em;">Total : {{ cart.total_price | money }} <span class="sans" style="font-size: 11px; font-weight: 300; color: #6b6558;">TTC</span></div>
            <div class="sans" style="font-size: 11.5px; font-weight: 300; color: #6b6558; margin-top: 6px;">{% if settings.free_shipping %}Livraison offerte.{% else %}Frais de livraison calculés à l'étape suivante.{% endif %}</div>
          </div>
        </div>

        {% # Réassurance pré-checkout %}
        <div style="margin-top: 28px; display: flex; flex-direction: column; gap: 10px; padding: 20px; background: #F8F4ED;">
          <div class="trust-row">
            <svg class="trust-check" viewBox="0 0 24 24" fill="none" stroke="#B08D57" stroke-width="1.8"><polyline points="20 6 9 17 4 12"/></svg>
            Paiement sécurisé
          </div>
          <div class="trust-row">
            <svg class="trust-check" viewBox="0 0 24 24" fill="none" stroke="#B08D57" stroke-width="1.8"><polyline points="20 6 9 17 4 12"/></svg>
            Expédition sous {{ settings.prep_time }} · Livraison suivie avec numéro de suivi
          </div>
          <div class="trust-row">
            <svg class="trust-check" viewBox="0 0 24 24" fill="none" stroke="#B08D57" stroke-width="1.8"><polyline points="20 6 9 17 4 12"/></svg>
            Retours acceptés sous {{ settings.return_days }} jours à compter de la réception{% if settings.free_returns %} · gratuits{% endif %}
          </div>
        </div>

        <button type="submit" name="checkout" class="btn btn-dark" style="width: 100%; margin-top: 16px; padding: 16px 24px; font-size: 10.5px;">
          Paiement sécurisé · Commander
        </button>
        {% if shop.enabled_payment_types.size > 0 %}
        <div class="pay-icons" style="justify-content: center; margin-top: 14px;">
          <span class="visually-hidden">Moyens de paiement acceptés :</span>
          {% for type in shop.enabled_payment_types %}{{ type | payment_type_svg_tag: class: 'pay-icon' }}{% endfor %}
        </div>
        {% endif %}

      {% endform %}

    {% endif %}

  </div>
</div>

<style>
.cart-lines { list-style: none; margin: 0; padding: 0; border-top: 1px solid rgba(27,24,18,.1); }
.cart-line { display: grid; grid-template-columns: 88px minmax(0, 1fr) auto; gap: 16px; align-items: start; padding: 20px 0; border-bottom: 1px solid rgba(27,24,18,.1); }
.cart-line-img { display: block; width: 88px; height: 88px; background: #F3EEE3; overflow: hidden; }
.cart-line-img img { width: 100%; height: 100%; object-fit: cover; }
.cart-line-info { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
.cart-line-title { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 18px; line-height: 1.3; color: #17140F; }
.cart-line-variant { font-family: 'Montserrat', sans-serif; font-size: 12px; font-weight: 300; color: #6b6558; }
.cart-line-discount { font-family: 'Montserrat', sans-serif; font-size: 11.5px; color: #7A5C2E; }
.cart-line-actions { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; margin-top: 10px; }
.cart-qty { display: inline-flex; align-items: center; border: 1px solid rgba(27,24,18,.22); }
.cart-qty-btn { width: 38px; height: 38px; display: inline-flex; align-items: center; justify-content: center; font-family: 'Montserrat', sans-serif; font-size: 16px; color: #17140F; transition: background .2s ease; }
.cart-qty-btn:hover { background: #F3EEE3; }
.cart-qty-value { min-width: 28px; text-align: center; font-family: 'Montserrat', sans-serif; font-size: 13px; color: #17140F; }
.cart-remove { display: inline-flex; align-items: center; gap: 6px; padding: 9px 12px; border: 1px solid rgba(122,31,43,.3); font-family: 'Montserrat', sans-serif; font-size: 10.5px; letter-spacing: .1em; text-transform: uppercase; color: #7A1F2B; transition: background .2s ease, border-color .2s ease; }
.cart-remove:hover { background: rgba(122,31,43,.06); border-color: #7A1F2B; }
.cart-remove svg { width: 14px; height: 14px; }
.cart-line-price { display: flex; flex-direction: column; align-items: flex-end; gap: 2px; font-family: 'Montserrat', sans-serif; font-size: 14px; font-weight: 300; color: #17140F; white-space: nowrap; }
.cart-line-price s { font-size: 12px; color: #6b6558; }
@media (max-width: 560px) {
  .cart-line { grid-template-columns: 72px minmax(0, 1fr); gap: 12px; }
  .cart-line-img { width: 72px; height: 72px; }
  .cart-line-price { grid-column: 2; align-items: flex-start; flex-direction: row; gap: 8px; }
}
</style>

{% schema %}
{ "name": "Panier", "settings": [] }
{% endschema %}
