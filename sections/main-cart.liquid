<div class="sect" style="width: 100%; min-height: 50vh;">
  <div style="max-width: 860px; margin: 0 auto;">

    <h1 class="serif" style="font-size: clamp(26px, 4.5vw, 34px); font-weight: 300; margin-bottom: 40px; letter-spacing: -.005em;">Votre panier</h1>

    {% if cart.item_count == 0 %}
      <div style="display: flex; flex-direction: column; gap: 20px; align-items: flex-start; padding: clamp(40px, 6vw, 60px) 0;">
        <p class="sans" style="color: #4A463D; font-size: 14px; font-weight: 300; line-height: 1.7; margin: 0;">Votre panier est vide pour l'instant.</p>
        <a href="{{ routes.root_url }}" class="btn">Découvrir la pièce</a>
      </div>

    {% else %}

      {%- liquid
        # Code parure appliqué ? Il n'est pas cumulable avec l'offre de lancement
        assign bundle_applied = false
        assign bundle_code = settings.bundle_discount_code | strip | upcase
        if bundle_code != blank
          for app in cart.discount_applications
            assign app_title = app.title | upcase
            if app_title == bundle_code
              assign bundle_applied = true
            endif
          endfor
        endif
      -%}
      {% if bundle_applied %}
      <!-- Rappel offre parure -->
      <div class="offer-box" style="margin-bottom: 32px;">
        <span class="offer-box-title">Offre parure appliquée</span>
        <p class="offer-box-content" style="margin: 0;">Le collier et les boucles d'oreilles vous sont proposés au prix de la parure. La remise est déjà déduite du total ci-dessous.</p>
      </div>
      {% elsif settings.offer_active %}
      <!-- Rappel offre 1+1 -->
      <div class="offer-box" style="margin-bottom: 32px;">
        <span class="offer-box-title">Offre de lancement incluse</span>
        <p class="offer-box-content" style="margin: 0;">Votre commande inclut une seconde pièce offerte. Vous recevrez deux bijoux dans leurs écrins respectifs, dans un seul colis.{% if settings.offer_end_date != blank %} Offre valable jusqu'au {{ settings.offer_end_date }} inclus.{% endif %}</p>
      </div>
      {% endif %}

      {% form 'cart', cart %}
        <table class="cart-table">
          <thead>
            <tr>
              <th class="sans" style="font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: #6b6558; font-weight: 400; padding-bottom: 14px;"><span class="visually-hidden">Photo</span></th>
              <th class="sans" style="font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: #6b6558; font-weight: 400; padding-bottom: 14px;">Pièce</th>
              <th class="sans" style="font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: #6b6558; font-weight: 400; padding-bottom: 14px;">Quantité</th>
              <th class="sans" style="font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: #6b6558; font-weight: 400; padding-bottom: 14px; text-align: right;">Sous-total</th>
            </tr>
          </thead>
          <tbody>
            {% for item in cart.items %}
              <tr>
                <td style="width: 80px; padding-right: 16px;">
                  {% if item.image %}
                    <img src="{{ item.image | image_url: width: 150 }}" alt="{{ item.image.alt | default: item.product.title | escape }}" width="72" height="72" loading="lazy" style="width: 72px; height: 72px; object-fit: cover; background: #F3EEE3;">
                  {% else %}
                    <div style="width: 72px; height: 72px; background: #F3EEE3;" aria-hidden="true"></div>
                  {% endif %}
                </td>
                <td>
                  <div class="sans" style="font-size: 13.5px; font-weight: 300; color: #17140F; line-height: 1.4;">{{ item.product.title }}</div>
                  {% unless item.product.has_only_default_variant %}
                    <div class="sans" style="font-size: 12px; font-weight: 300; color: #6b6558; margin-top: 3px;">{{ item.variant.title }}</div>
                  {% endunless %}
                  {% for discount in item.line_level_discount_allocations %}
                    {% if discount.amount > 0 %}<div class="sans" style="font-size: 11.5px; font-weight: 400; color: #7A5C2E; margin-top: 4px;">{{ discount.discount_application.title }} (−{{ discount.amount | money }})</div>{% endif %}
                  {% endfor %}
                  <a href="{{ item.url_to_remove }}" aria-label="Retirer {{ item.product.title | escape }} du panier" class="sans" style="font-size: 10.5px; font-weight: 300; color: #6b6558; letter-spacing: .04em; margin-top: 6px; display: inline-block; border-bottom: 1px solid rgba(156,150,138,.3); padding-bottom: 1px; transition: color .2s ease;" onmouseover="this.style.color='#4A463D'" onmouseout="this.style.color='#9c968a'">Retirer</a>
                </td>
                <td>
                  <input class="qty-input sans" type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantité — {{ item.product.title | escape }}">
                </td>
                <td class="sans" style="text-align: right; font-size: 14px; font-weight: 300; color: #17140F;">
                  {% if item.original_line_price > item.final_line_price %}<s style="color: #6b6558; font-size: 12px; display: block;"><span class="visually-hidden">Prix avant remise :</span>{{ item.original_line_price | money }}</s>{% endif %}
                  {% if item.final_line_price == 0 %}Offert{% else %}{{ item.final_line_price | money }}{% endif %}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>

        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 24px; flex-wrap: wrap; gap: 16px; padding-top: 20px; border-top: 1px solid rgba(27,24,18,.1);">
          <button type="submit" name="update" class="sans" style="background: none; border: none; cursor: pointer; font-size: 11px; letter-spacing: .08em; color: #6b6558; padding: 0; text-decoration: underline; text-underline-offset: 3px; transition: color .2s ease;" onmouseover="this.style.color='#17140F'" onmouseout="this.style.color='#9c968a'">Mettre à jour</button>
          <div style="text-align: right;">
            {% for discount in cart.cart_level_discount_applications %}
              <div class="sans" style="font-size: 12px; font-weight: 400; color: #7A5C2E; margin-bottom: 6px;">{{ discount.title }} : −{{ discount.total_allocated_amount | money }}</div>
            {% endfor %}
            <div class="serif" style="font-size: 22px; font-weight: 400; color: #17140F; letter-spacing: .02em;">Total : {{ cart.total_price | money }} <span class="sans" style="font-size: 11px; font-weight: 300; color: #6b6558;">TTC</span></div>
            <div class="sans" style="font-size: 11.5px; font-weight: 300; color: #6b6558; margin-top: 6px;">{% if settings.free_shipping %}Livraison offerte.{% else %}Frais de livraison calculés à l'étape suivante.{% endif %}</div>
          </div>
        </div>

        <!-- Réassurance pré-checkout -->
        <div style="margin-top: 28px; display: flex; flex-direction: column; gap: 10px; padding: 20px; background: #F8F4ED;">
          <div class="trust-row">
            <svg class="trust-check" viewBox="0 0 24 24" fill="none" stroke="#B08D57" stroke-width="1.8"><polyline points="20 6 9 17 4 12"/></svg>
            Paiement sécurisé
          </div>
          <div class="trust-row">
            <svg class="trust-check" viewBox="0 0 24 24" fill="none" stroke="#B08D57" stroke-width="1.8"><polyline points="20 6 9 17 4 12"/></svg>
            Expédition sous {{ settings.prep_time }} · Livraison suivie avec numéro de suivi
          </div>
          <div class="trust-row">
            <svg class="trust-check" viewBox="0 0 24 24" fill="none" stroke="#B08D57" stroke-width="1.8"><polyline points="20 6 9 17 4 12"/></svg>
            Retours acceptés sous {{ settings.return_days }} jours à compter de la réception{% if settings.free_returns %} · gratuits{% endif %}
          </div>
        </div>

        <button type="submit" name="checkout" class="btn btn-dark" style="width: 100%; margin-top: 16px; padding: 16px 24px; font-size: 10.5px;">
          Passer à la commande
        </button>

      {% endform %}

    {% endif %}

  </div>
</div>

{% schema %}
{ "name": "Panier", "settings": [] }
{% endschema %}
