{%- liquid
  # Pièce signature (collier) : on écarte les boucles d'oreilles du choix par défaut
  assign featured_product = section.settings.product
  if featured_product == blank
    for p in collections.all.products
      unless p.title contains 'oreilles'
        assign featured_product = p
        break
      endunless
    endfor
  endif
-%}
{% assign has_reviews = false %}
{% assign review_count = 0 %}
{% assign rating_sum = 0 %}
{% for block in section.blocks %}
  {% if block.settings.text != blank %}
    {% assign has_reviews = true %}
    {% assign review_count = review_count | plus: 1 %}
    {% assign rating_sum = rating_sum | plus: block.settings.rating %}
  {% endif %}
{% endfor %}

{% if has_reviews %}
{% assign avg_rating = rating_sum | times: 1.0 | divided_by: review_count %}
{% assign avg_rounded = avg_rating | round %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  {%- if featured_product %}
  "@id": {{ request.origin | append: featured_product.url | append: '#product' | json }},
  "name": {{ featured_product.title | json }},
  "url": {{ request.origin | append: featured_product.url | json }},
  {%- if featured_product.featured_image %}
  "image": {{ featured_product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }},
  {%- endif %}
  "offers": {
    "@type": "Offer",
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "price": {{ featured_product.price | divided_by: 100.0 | json }},
    "availability": {% if featured_product.available %}"https://schema.org/InStock"{% else %}"https://schema.org/OutOfStock"{% endif %}
  },
  {%- else %}
  "name": "La Goutte d'Émeraude",
  {%- endif %}
  "brand": { "@type": "Brand", "name": "Maison L'Émeraude" },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "{{ avg_rating | round: 1 }}",
    "reviewCount": "{{ review_count }}",
    "bestRating": "5",
    "worstRating": "1"
  },
  "review": [
    {% for block in section.blocks %}
    {% if block.settings.text != blank %}
    {
      "@type": "Review",
      "reviewBody": {{ block.settings.text | json }},
      "author": {
        "@type": "Person",
        "name": {{ block.settings.author | default: "Cliente" | json }}
      },
      "reviewRating": {
        "@type": "Rating",
        "ratingValue": "{{ block.settings.rating | default: 5 }}",
        "bestRating": "5",
        "worstRating": "1"
      }
    }{% unless forloop.last %},{% endunless %}
    {% endif %}
    {% endfor %}
  ]
}
</script>
{% endif %}

<div style="width: 100%; background: #FBF8F2; padding: clamp(72px, 11vw, 136px) clamp(18px, 5vw, 36px);">
  <div style="max-width: 1100px; margin: 0 auto;">

    {% if has_reviews %}

      {% # ÉTAT AVEC VRAIS AVIS %}
      <div style="text-align: center; display: flex; flex-direction: column; align-items: center; gap: 14px; margin-bottom: clamp(48px, 7vw, 72px);">
        <span class="eyebrow ml-reveal" style="font-size: 10px; color: #7A5C2E; letter-spacing: .28em;">Avis clients</span>
        <h2 class="serif ml-reveal ml-d1" style="margin: 0; font-size: clamp(22px, 3.5vw, 30px); font-weight: 300;">Ce qu'elles en disent</h2>
        {% # Note globale %}
        <div style="display: flex; align-items: center; gap: 8px; margin-top: 4px;">
          <div style="display: flex; gap: 3px;" role="img" aria-label="Note moyenne : {{ avg_rating | round: 1 }} sur 5">
            {% for i in (1..5) %}
              <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" {% if i <= avg_rounded %}fill="#B08D57" stroke="none"{% else %}fill="none" stroke="#C8B89A" stroke-width="1.5"{% endif %}/></svg>
            {% endfor %}
          </div>
          <span class="sans" style="font-size: 12px; font-weight: 300; color: #6b6558;">{{ avg_rating | round: 1 | replace: '.', ',' }}/5 · {{ review_count }} avis</span>
        </div>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px;">
        {% for block in section.blocks %}
          {% if block.settings.text != blank %}
            <div style="padding: clamp(24px, 3vw, 32px); border: 1px solid rgba(27,24,18,.1); display: flex; flex-direction: column; gap: 14px; background: #FBF8F2;" {{ block.shopify_attributes }}>

              {% # Étoiles %}
              <div style="display: flex; gap: 3px;" role="img" aria-label="Note : {{ block.settings.rating }} sur 5">
                {% assign stars = block.settings.rating %}
                {% for i in (1..5) %}
                  <svg width="13" height="13" viewBox="0 0 24 24" aria-hidden="true">
                    {% if i <= stars %}
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" fill="#B08D57" stroke="none"/>
                    {% else %}
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" fill="none" stroke="#C8B89A" stroke-width="1.5"/>
                    {% endif %}
                  </svg>
                {% endfor %}
              </div>

              {% # Texte %}
              <p class="serif" style="margin: 0; font-size: 17px; line-height: 1.6; font-style: italic; color: #1B1812;">"{{ block.settings.text }}"</p>

              {% # Auteur %}
              <div style="display: flex; justify-content: space-between; align-items: flex-end; gap: 8px; flex-wrap: wrap; margin-top: 4px;">
                <div>
                  <span class="sans" style="font-size: 12.5px; font-weight: 400; color: #17140F; display: block;">{{ block.settings.author | default: "Cliente" }}</span>
                  {% if block.settings.date != blank %}
                    <span class="sans" style="font-size: 11px; font-weight: 300; color: #6b6558; display: block; margin-top: 2px;">{{ block.settings.date }}</span>
                  {% endif %}
                </div>
                {% if block.settings.verified %}
                  <span class="sans" style="display: inline-flex; align-items: center; gap: 4px; font-size: 10px; color: #7A5C2E; letter-spacing: .06em; text-transform: uppercase;">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#B08D57" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                    Achat vérifié
                  </span>
                {% endif %}
              </div>

            </div>
          {% endif %}
        {% endfor %}
      </div>

    {% else %}

      {% # ÉTAT PRÉ-LANCEMENT %}

      <div style="display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(48px, 7vw, 96px); align-items: center;" class="reviews-prelaunch-grid">

        {% # Gauche : texte %}
        <div style="display: flex; flex-direction: column; gap: 28px;">
          <span class="eyebrow" style="font-size: 10px; color: #7A5C2E; letter-spacing: .28em;">Avis clients</span>
          <h2 class="serif" style="margin: 0; font-size: clamp(24px, 4vw, 36px); font-weight: 300; line-height: 1.2;">Soyez parmi les premières à donner votre avis.</h2>
          <p class="sans" style="margin: 0; font-size: 13.5px; font-weight: 300; line-height: 1.9; color: #4A463D; letter-spacing: .015em;">La boutique vient d'ouvrir et les premières commandes sont en cours de livraison. Les avis de nos clientes seront publiés ici dès réception.</p>

          {% # Mention sur les avis %}
          <div style="border-left: 2px solid rgba(176,141,87,.4); padding-left: 20px; display: flex; flex-direction: column; gap: 10px;">
            <p class="sans" style="margin: 0; font-size: 12.5px; font-weight: 300; line-height: 1.75; color: #6b6558; font-style: italic;">Nous publions uniquement les avis de clientes ayant passé commande, sans les modifier.</p>
          </div>

          {% # Ce que nos clientes pourront partager %}
          <div style="display: flex; flex-direction: column; gap: 8px; margin-top: 4px;">
            <span class="eyebrow" style="font-size: 9px; color: #6b6558; letter-spacing: .18em;">Vous pourrez nous donner votre avis sur</span>
            <div style="display: flex; flex-direction: column; gap: 7px;">
              <span class="trust-row"><svg class="trust-check" viewBox="0 0 24 24" fill="none" stroke="#B08D57" stroke-width="1.8"><polyline points="20 6 9 17 4 12"/></svg>La qualité du bijou</span>
              <span class="trust-row"><svg class="trust-check" viewBox="0 0 24 24" fill="none" stroke="#B08D57" stroke-width="1.8"><polyline points="20 6 9 17 4 12"/></svg>L'écrin et la présentation</span>
              <span class="trust-row"><svg class="trust-check" viewBox="0 0 24 24" fill="none" stroke="#B08D57" stroke-width="1.8"><polyline points="20 6 9 17 4 12"/></svg>La livraison</span>
            </div>
          </div>
        </div>

        {% # Droite : aperçu visuel de la section à venir (décoratif) %}
        <div style="display: flex; flex-direction: column; gap: 16px;" aria-hidden="true">

          {% # 3 cartes « en attente » %}
          {% for i in (1..3) %}
            <div style="padding: 22px 24px; border: 1px solid rgba(27,24,18,.08); display: flex; flex-direction: column; gap: 12px; background: rgba(27,24,18,.02);">
              {% # Étoiles placeholder %}
              <div style="display: flex; gap: 3px;">
                {% for j in (1..5) %}
                  <svg width="11" height="11" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" fill="#B08D57" stroke="none" opacity=".25"/></svg>
                {% endfor %}
              </div>
              {% # Lignes placeholder %}
              <div style="display: flex; flex-direction: column; gap: 6px;">
                <div style="height: 10px; background: rgba(27,24,18,.07); border-radius: 1px; width: {% if i == 1 %}82%{% elsif i == 2 %}68%{% else %}75%{% endif %};"></div>
                <div style="height: 10px; background: rgba(27,24,18,.05); border-radius: 1px; width: {% if i == 1 %}55%{% elsif i == 2 %}40%{% else %}58%{% endif %};"></div>
              </div>
              {% # Auteur placeholder %}
              <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 4px;">
                <div style="height: 8px; background: rgba(27,24,18,.06); border-radius: 1px; width: 30%;"></div>
                <span class="sans" style="font-size: 9.5px; letter-spacing: .08em; color: #6b6558; text-transform: uppercase;">Bientôt</span>
              </div>
            </div>
          {% endfor %}

        </div>
      </div>

    {% endif %}

  </div>
</div>

<style>
@media (max-width: 860px) {
  .reviews-prelaunch-grid { grid-template-columns: 1fr !important; }
}
</style>

{% schema %}
{
  "name": "Avis clients",
  "settings": [
    { "type": "product", "id": "product", "label": "Pièce évaluée" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Avis",
      "settings": [
        { "type": "textarea", "id": "text", "label": "Texte de l'avis (tel que reçu — ne pas modifier)" },
        { "type": "text", "id": "author", "label": "Prénom et initiale (ex : Sophie M.)" },
        { "type": "text", "id": "date", "label": "Date (ex : Septembre 2025)" },
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "Note", "default": 5 },
        { "type": "checkbox", "id": "verified", "label": "Achat vérifié (cocher uniquement si l'achat peut être confirmé)", "default": false }
      ]
    }
  ]
}
{% endschema %}
