{% assign featured_product = section.settings.product | default: collections.all.products.first %}

<div id="offre" class="sect" style="width: 100%;">
  <div style="max-width: 1100px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 48px;">
    <div style="text-align: center; display: flex; flex-direction: column; align-items: center; gap: 20px; max-width: 560px;">
      <span class="sans" style="font-size: 12px; letter-spacing: .18em; text-transform: uppercase; color: #B08D57;">Offre de lancement</span>
      <h2 class="serif" style="margin: 0; font-size: clamp(26px, 4.5vw, 36px); line-height: 1.25; font-weight: 420;">Gardez-en un. Offrez l'autre.</h2>
      <p class="sans" style="margin: 0; font-size: 15.5px; line-height: 1.8; color: #4A463D;">Pour célébrer le lancement de la Maison, nous avons choisi d'offrir une seconde pièce. Une pour vous, une à offrir, ou deux à garder.</p>
    </div>
    <div style="width: 100%; max-width: 720px; margin: 0 auto;">
      <img src="{{ 'offer-lancement.png' | asset_url }}" alt="Offre de lancement — 1 acheté, 1 offert" style="width: 100%; height: auto; display: block; border-radius: 4px;">
    </div>
    <a href="{{ featured_product.url | default: '#piece' }}" class="btn">Profiter de l'offre</a>
  </div>
</div>

{% schema %}
{
  "name": "Offre de lancement",
  "settings": [
    { "type": "product", "id": "product", "label": "Pièce mise en avant" }
  ]
}
{% endschema %}
