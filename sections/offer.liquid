{%- if settings.offer_active -%}
{% assign featured_product = section.settings.product | default: collections.all.products.first %}

<div id="offre" style="width: 100%; background: #F3EEE3; padding: clamp(72px, 12vw, 140px) clamp(18px, 5vw, 36px);">
  <div style="max-width: 1100px; margin: 0 auto;">

    <!-- Titre éditorial -->
    <div style="text-align: center; display: flex; flex-direction: column; align-items: center; gap: 18px; margin-bottom: clamp(48px, 7vw, 80px); max-width: 600px; margin-left: auto; margin-right: auto;">
      <span class="eyebrow" style="font-size: 10px; color: #7A5C2E; letter-spacing: .28em;">Offre de lancement</span>
      <span style="display: block; width: 24px; height: 1px; background: rgba(176,141,87,.6);"></span>
      <h2 class="serif" style="margin: 0; font-size: clamp(26px, 4.5vw, 38px); line-height: 1.2; font-weight: 300;">{{ section.settings.headline | default: "Une pour vous.<br>Une à offrir." }}</h2>
      <p class="sans" style="margin: 0; font-size: 14px; line-height: 1.85; color: #4A463D; font-weight: 300; max-width: 480px; letter-spacing: .015em;">{{ section.settings.body | default: "Pour fêter l'ouverture de la Maison, nous avons décidé d'offrir une seconde pièce à chaque commande passée pendant cette période de lancement. Deux bijoux. Deux écrins. Un seul prix." }}</p>
    </div>

    <!-- Image + Explication -->
    <div class="grid-2" style="align-items: start; gap: clamp(36px, 5vw, 80px);">

      <!-- Image -->
      <div style="width: 100%; overflow: hidden; background: #EAE4D7;">
        <img
          src="{{ 'offer-lancement.jpg' | asset_url }}"
          srcset="{{ 'offer-lancement-600.jpg' | asset_url }} 600w, {{ 'offer-lancement.jpg' | asset_url }} 1100w"
          sizes="(max-width: 860px) 100vw, 50vw"
          width="1100"
          height="899"
          alt="Deux colliers La Goutte d'Émeraude côte à côte : 1 acheté, 1 offert"
          style="width: 100%; height: auto; display: block;"
          loading="lazy"
        >
      </div>

      <!-- Explication concrète -->
      <div style="display: flex; flex-direction: column; gap: 32px;">

        <div style="display: flex; flex-direction: column; gap: 24px;">
          <div style="display: flex; gap: 20px; align-items: flex-start;">
            <span class="serif" style="font-size: 13px; font-style: italic; color: #7A5C2E; flex-shrink: 0; width: 20px; padding-top: 2px;">1</span>
            <div>
              <div class="sans" style="font-size: 12.5px; font-weight: 400; letter-spacing: .06em; color: #17140F; margin-bottom: 6px; text-transform: uppercase; font-size: 10px; letter-spacing: .15em;">Vous commandez</div>
              <p class="sans" style="margin: 0; font-size: 13.5px; font-weight: 300; line-height: 1.7; color: #4A463D;">Ajoutez une pièce à votre panier et finalisez votre commande normalement.</p>
            </div>
          </div>
          <div style="display: flex; gap: 20px; align-items: flex-start;">
            <span class="serif" style="font-size: 13px; font-style: italic; color: #7A5C2E; flex-shrink: 0; width: 20px; padding-top: 2px;">2</span>
            <div>
              <div class="sans" style="font-size: 10px; font-weight: 400; letter-spacing: .15em; text-transform: uppercase; color: #17140F; margin-bottom: 6px;">Nous préparons deux écrins</div>
              <p class="sans" style="margin: 0; font-size: 13.5px; font-weight: 300; line-height: 1.7; color: #4A463D;">Votre commande est préparée avec deux pièces identiques dans leurs écrins respectifs, soigneusement emballés.</p>
            </div>
          </div>
          <div style="display: flex; gap: 20px; align-items: flex-start;">
            <span class="serif" style="font-size: 13px; font-style: italic; color: #7A5C2E; flex-shrink: 0; width: 20px; padding-top: 2px;">3</span>
            <div>
              <div class="sans" style="font-size: 10px; font-weight: 400; letter-spacing: .15em; text-transform: uppercase; color: #17140F; margin-bottom: 6px;">Vous recevez deux bijoux</div>
              <p class="sans" style="margin: 0; font-size: 13.5px; font-weight: 300; line-height: 1.7; color: #4A463D;">Deux La Goutte d'Émeraude. Deux écrins signature. Un seul colis suivi, livré sous {{ settings.shipping_delay }} après expédition.</p>
            </div>
          </div>
        </div>

        <div style="border-top: 1px solid rgba(27,24,18,.1); padding-top: 24px;">
          {% if settings.offer_end_date != blank %}
            <p class="sans" style="margin: 0 0 10px; font-size: 12px; font-weight: 400; letter-spacing: .04em; color: #17140F;">Offre valable jusqu'au {{ settings.offer_end_date }} inclus.</p>
          {% endif %}
          <p class="sans" style="margin: 0 0 20px; font-size: 12px; font-weight: 300; line-height: 1.7; color: #6b6558; font-style: italic;">{{ section.settings.disclaimer | default: "Offre valable pendant la période de lancement uniquement, dans la limite des stocks disponibles. Un seul bijou supplémentaire par commande." }}</p>
          <a href="{{ featured_product.url | default: '#piece' }}" class="btn">Profiter de l'offre</a>
        </div>

      </div>
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Offre de lancement",
  "settings": [
    { "type": "product", "id": "product", "label": "Pièce mise en avant" },
    { "type": "text", "id": "headline", "label": "Titre" },
    { "type": "textarea", "id": "body", "label": "Introduction" },
    { "type": "textarea", "id": "disclaimer", "label": "Mention légale / conditions" }
  ]
}
{% endschema %}
