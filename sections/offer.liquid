{%- if settings.offer_active -%}
{%- capture piece_handles -%}{% render 'piece-handles' %}{%- endcapture -%}
{%- liquid
  assign featured_product = section.settings.product
  if featured_product == blank
    assign piece_handles = piece_handles | split: '|'
    assign featured_product = all_products[piece_handles[0]]
  endif
-%}

<section id="offre" class="of">
  <div class="of-inner">
    <div class="of-head ml-reveal">
      <span class="of-eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="serif of-title">{{ section.settings.headline }}</h2>
    </div>
    <div class="of-body ml-reveal ml-d1">
      <p class="of-text">{{ section.settings.body }}</p>
      <div class="of-actions">
        <a href="#collection" class="of-btn">Choisir mon bijou</a>
        {% if settings.offer_end_date != blank %}<span class="of-date">Jusqu’au {{ settings.offer_end_date }} inclus</span>{% endif %}
      </div>
      <p class="of-legal">{{ section.settings.disclaimer }}</p>
    </div>
  </div>
</section>

<style>
.of { background: #F2ECE2; padding: clamp(64px, 9vw, 120px) clamp(20px, 5vw, 48px); border-top: 1px solid rgba(15,48,39,.08); border-bottom: 1px solid rgba(15,48,39,.08); }
.of-inner { max-width: 1120px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 96px); align-items: end; }
.of-head { display: flex; flex-direction: column; gap: 16px; }
.of-eyebrow { font-family: 'Manrope', 'Helvetica Neue', Arial, sans-serif; font-size: 12px; font-weight: 500; letter-spacing: .16em; text-transform: uppercase; color: #8A6A3A; }
.of-title { margin: 0; font-size: clamp(38px, 5.6vw, 68px); font-weight: 300; line-height: 1.02; letter-spacing: -.015em; color: #0F3027; }
.of-body { display: flex; flex-direction: column; gap: 22px; }
.of-text { margin: 0; font-family: 'Manrope', 'Helvetica Neue', Arial, sans-serif; font-size: 16px; font-weight: 400; line-height: 1.75; color: #3E3B35; }
.of-actions { display: flex; align-items: center; gap: 22px; flex-wrap: wrap; }
.of-btn { display: inline-flex; align-items: center; min-height: 54px; padding: 0 30px; background: #0F3027; color: #FBF8F2; font-family: 'Manrope', 'Helvetica Neue', Arial, sans-serif; font-size: 13px; font-weight: 600; letter-spacing: .06em; transition: background .3s ease; }
.of-btn:hover { background: #155E48; }
.of-date { font-family: 'Manrope', 'Helvetica Neue', Arial, sans-serif; font-size: 13px; font-weight: 500; color: #0F3027; }
.of-legal { margin: 0; font-family: 'Manrope', 'Helvetica Neue', Arial, sans-serif; font-size: 12px; line-height: 1.6; color: #6B665C; }
@media (max-width: 860px) { .of-inner { grid-template-columns: 1fr; align-items: start; } }
</style>
{%- endif -%}

{% schema %}
{
  "name": "Offre de lancement",
  "settings": [
    { "type": "product", "id": "product", "label": "Pièce mise en avant" },
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "L’ouverture de la Maison" },
    { "type": "text", "id": "headline", "label": "Titre", "default": "Un pour vous, un à offrir." },
    { "type": "textarea", "id": "body", "label": "Texte", "default": "Pour célébrer l’ouverture, chaque commande est accompagnée d’un second bijou identique, offert. Les deux arrivent ensemble, chacun dans son écrin : l’un pour vous, l’autre pour quelqu’un qui compte." },
    { "type": "textarea", "id": "disclaimer", "label": "Conditions", "default": "Un bijou offert par commande, identique à la pièce achetée, dans la limite des stocks disponibles. Non cumulable avec les remises parure : la plus avantageuse s’applique." }
  ]
}
{% endschema %}
