<div class="sect" style="width: 100%;">
  <div style="max-width: 1200px; margin: 0 auto;" class="grid-2 grid-pdp">
    <div class="pdp-gallery">
      <img src="{{ product.featured_image | image_url: width: 1000 }}" alt="{{ product.featured_image.alt | default: product.title }}" id="MainProductImage">
      {% if product.images.size > 1 %}
        <div class="pdp-thumbs">
          {% for image in product.images %}
            <img src="{{ image | image_url: width: 200 }}" alt="{{ image.alt | default: product.title }}" onclick="document.getElementById('MainProductImage').src=this.src.replace('width=200','width=1000')">
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div style="display: flex; flex-direction: column; gap: 20px;">
      <span class="sans" style="font-size: 12px; letter-spacing: .18em; text-transform: uppercase; color: #B08D57;">La pièce signature</span>
      <h1 class="serif" style="margin: 0; font-size: clamp(28px, 5vw, 38px); line-height: 1.2; font-weight: 420;">{{ product.title }}</h1>

      <div class="serif price">
        {% if product.compare_at_price > product.price %}
          <span class="compare-price">{{ product.compare_at_price | money }}</span>
        {% endif %}
        {{ product.price | money }}
      </div>

      <div class="sans" style="font-size: 15px; line-height: 1.8; color: #4A463D;">{{ product.description }}</div>

      {% form 'product', product %}
        {% unless product.has_only_default_variant %}
          {% for option in product.options_with_values %}
            <div style="margin-top: 10px;">
              <label class="sans" style="font-size: 12.5px; letter-spacing: .08em; text-transform: uppercase; color: #17140F;">{{ option.name }}</label><br>
              <select name="options[{{ option.name | escape }}]" class="sans" style="margin-top: 8px; padding: 10px; border: 1px solid rgba(27,24,18,.25); background: transparent; min-width: 160px;">
                {% for value in option.values %}
                  <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>
                {% endfor %}
              </select>
            </div>
          {% endfor %}
        {% endunless %}

        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

        <div style="display: flex; align-items: center; gap: 16px; margin-top: 20px;">
          <input type="number" name="quantity" value="1" min="1" class="qty-input">
          <button type="submit" class="btn" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %} style="flex-grow: 1;">
            {% if product.selected_or_first_available_variant.available %}
              {{ 'products.product.add_to_cart' | t }}
            {% else %}
              {{ 'products.product.sold_out' | t }}
            {% endif %}
          </button>
        </div>
      {% endform %}

      <p class="sans" style="font-size: 12.5px; color: #6b6558; margin-top: 8px;">Paiement sécurisé. Expédition suivie. Retours selon nos conditions de vente.</p>

      <ul class="sans" style="list-style: none; margin: 16px 0 0; padding: 0; display: flex; flex-direction: column; gap: 10px; font-size: 14.5px; color: #17140F;">
        <li style="display: flex; justify-content: space-between; border-top: 1px solid rgba(27,24,18,.12); padding-top: 10px;"><span style="color: #6b6558;">Pierre centrale</span><span>{{ section.settings.stone | default: "Cristal synthétique vert profond" }}</span></li>
        <li style="display: flex; justify-content: space-between; border-top: 1px solid rgba(27,24,18,.12); padding-top: 10px;"><span style="color: #6b6558;">Métal</span><span>{{ section.settings.metal | default: "Acier inoxydable doré à l'or fin" }}</span></li>
        <li style="display: flex; justify-content: space-between; border-top: 1px solid rgba(27,24,18,.12); padding-top: 10px;"><span style="color: #6b6558;">Longueur de chaîne</span><span>{{ section.settings.chain_length | default: "42 cm — rallonge incluse jusqu'à 47 cm" }}</span></li>
      </ul>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Page produit",
  "settings": [
    { "type": "text", "id": "stone", "label": "Nature de la pierre" },
    { "type": "text", "id": "metal", "label": "Métal" },
    { "type": "text", "id": "chain_length", "label": "Longueur de chaîne" }
  ]
}
{% endschema %}
