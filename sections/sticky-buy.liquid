{%- capture piece_handles -%}{% render 'piece-handles' %}{%- endcapture -%}
{%- liquid
  assign sb_product = section.settings.product
  if sb_product == blank
    assign piece_handles = piece_handles | split: '|'
    assign sb_product = all_products[piece_handles[0]]
  endif
  assign sb_variant = sb_product.selected_or_first_available_variant
-%}

{%- if sb_product.available -%}
<div class="sbuy" id="StickyBuy" aria-hidden="true">
  {% if sb_product.featured_image %}<img src="{{ sb_product.featured_image | image_url: width: 120 }}" width="52" height="52" alt="" loading="lazy">{% endif %}
  <div class="sbuy-body">
    <span class="serif sbuy-title">{{ sb_product.title }}</span>
    <span class="sans sbuy-price">{{ sb_variant.price | money }}{% if settings.offer_active %} <em>+ 1 offert</em>{% endif %}</span>
  </div>
  {% if sb_product.has_only_default_variant %}
    <form method="post" action="{{ routes.cart_add_url }}" class="sbuy-form">
      <input type="hidden" name="id" value="{{ sb_variant.id }}">
      <input type="hidden" name="quantity" value="1">
      <button type="submit" class="sbuy-btn" tabindex="-1">Ajouter</button>
    </form>
  {% else %}
    <a href="{{ sb_product.url }}" class="sbuy-btn" tabindex="-1">Choisir</a>
  {% endif %}
</div>

<style>
.sbuy { position: fixed; left: 10px; right: 10px; bottom: 10px; z-index: 15; display: flex; align-items: center; gap: 12px; padding: 8px 8px 8px 8px; background: rgba(251,248,242,.97); box-shadow: 0 12px 40px rgba(12,38,32,.25); border: 1px solid rgba(201,169,110,.35); transform: translateY(140%); transition: transform .45s cubic-bezier(.16,1,.3,1); }
.sbuy.is-on { transform: none; }
.sbuy img { width: 52px; height: 52px; object-fit: cover; flex-shrink: 0; }
.sbuy-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
.sbuy-title { font-size: 16px; line-height: 1.15; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: #17140F; }
.sbuy-price { font-size: 12px; color: #17140F; }
.sbuy-price em { font-style: normal; color: #0F5A43; font-weight: 500; }
.sbuy-form { margin: 0; }
.sbuy-btn { display: inline-flex; align-items: center; min-height: 48px; padding: 0 22px; background: #0C2620; color: #FBF8F2; border: 0; font-family: 'Montserrat', sans-serif; font-size: 10.5px; letter-spacing: .18em; text-transform: uppercase; cursor: pointer; }
@media (min-width: 861px) { .sbuy { display: none; } }
@media (max-width: 860px) { .template-index footer { padding-bottom: 96px !important; } }
</style>

<script>
(function(){
  var bar = document.getElementById('StickyBuy');
  if (!bar) return;
  var btn = bar.querySelector('.sbuy-btn');
  function set(on){
    bar.classList.toggle('is-on', on);
    bar.setAttribute('aria-hidden', on ? 'false' : 'true');
    if (btn) btn.tabIndex = on ? 0 : -1;
  }
  // Visible après le hero, masquée sur le pied de page
  function check(){
    var y = window.scrollY, vh = window.innerHeight;
    var nearEnd = y + vh > document.documentElement.scrollHeight - 420;
    set(y > vh * 0.85 && !nearEnd);
  }
  window.addEventListener('scroll', check, { passive: true });
  check();
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Barre d'achat mobile",
  "settings": [
    { "type": "product", "id": "product", "label": "Pièce proposée", "info": "Par défaut : le collier." }
  ],
  "presets": [{ "name": "Barre d'achat mobile" }]
}
{% endschema %}
