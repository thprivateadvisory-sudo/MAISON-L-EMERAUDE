{% assign featured_product = section.settings.product | default: collections.all.products.first %}

<div style="width: 100%; position: relative; min-height: 88vh; display: flex; align-items: center; justify-content: center; overflow: hidden; background: #F3EEE3;">
  <img src="{{ 'paris.jpg' | asset_url }}" alt="Le collier {{ featured_product.title | default: section.settings.piece_name }} porté, devant une maison parisienne" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 62% 30%;">
  <div style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(23,20,15,.22) 0%, rgba(23,20,15,.04) 38%, rgba(23,20,15,.68) 100%);"></div>
  <div style="position: relative; text-align: center; padding: 0 20px; max-width: 720px; display: flex; flex-direction: column; align-items: center; gap: 20px;">
    <span class="eyebrow" style="color: rgba(243,238,227,.75);">{{ section.settings.brand_name | default: "Maison L'Émeraude" }}</span>
    <span class="ornament" style="background: rgba(176,141,87,.7);"></span>
    <h1 class="serif hero-title" style="margin: 0; line-height: 1.08; color: #FBF8F2;">{{ section.settings.headline | default: "Une pièce qui ne passe pas inaperçue" }}</h1>
    <p class="serif hero-sub" style="margin: 0; line-height: 1.65; color: rgba(251,248,242,.88); max-width: 460px;">{{ section.settings.subheadline | default: "Le bijou signature imaginé pour accompagner les moments que l'on n'oublie pas." }}</p>
    <div style="display: flex; gap: 20px; margin-top: 8px; flex-wrap: wrap; justify-content: center; align-items: center;">
      <a href="{{ featured_product.url | default: '#piece' }}" class="btn btn-light">Découvrir la pièce</a>
      <a href="#offre" class="sans" style="font-size: 10.5px; letter-spacing: .16em; text-transform: uppercase; color: rgba(251,248,242,.82); border-bottom: 1px solid rgba(251,248,242,.35); padding-bottom: 3px; transition: border-color .25s ease;">Voir l'offre de lancement</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "product", "id": "product", "label": "Pièce mise en avant" },
    { "type": "text", "id": "brand_name", "label": "Nom de la Maison", "default": "Maison L'Émeraude" },
    { "type": "text", "id": "headline", "label": "Titre", "default": "Une pièce qui ne passe pas inaperçue" },
    { "type": "textarea", "id": "subheadline", "label": "Sous-titre", "default": "Le bijou signature imaginé pour accompagner les moments que l'on n'oublie pas." },
    { "type": "text", "id": "piece_name", "label": "Nom de la pièce (si aucun produit choisi)", "default": "L'Émeraude Singulière" }
  ]
}
{% endschema %}
