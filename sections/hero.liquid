{%- capture piece_handles -%}{% render 'piece-handles' %}{%- endcapture -%}
{%- liquid
  # Pièce signature : le collier, sauf choix contraire dans l'éditeur
  assign featured_product = section.settings.product
  if featured_product == blank
    assign piece_handles = piece_handles | split: '|'
    assign featured_product = all_products[piece_handles[0]]
  endif
  assign fp_variant = featured_product.selected_or_first_available_variant
  assign proof = section.settings.proof | split: '|'
-%}

<section class="hx" aria-label="{{ section.settings.headline | escape }}">
  <div class="hx-media" aria-hidden="true">
    <img class="hx-poster"
      src="{{ 'paris.jpg' | asset_url }}"
      srcset="{{ 'paris-600.jpg' | asset_url }} 600w, {{ 'paris.jpg' | asset_url }} 1145w"
      sizes="100vw" width="1145" height="1374" alt="" loading="eager" fetchpriority="high">
    {% if section.settings.video != blank %}
      {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, preload: 'metadata', image_size: '1600x', class: 'hx-video' }}
    {% else %}
      <video class="hx-video" autoplay muted loop playsinline preload="metadata" poster="{{ 'film-maison-poster.jpg' | asset_url }}">
        <source src="{{ 'film-maison-mobile.mp4' | asset_url }}" type="video/mp4" media="(max-width: 760px)">
        <source src="{{ 'film-maison.mp4' | asset_url }}" type="video/mp4">
      </video>
    {% endif %}
  </div>
  <div class="hx-shade"></div>

  <div class="hx-inner">
    <div class="hx-copy">
      <span class="hx-eyebrow ha1">{{ section.settings.eyebrow }}</span>
      <h1 class="serif hx-title ha3">{{ section.settings.headline }}</h1>
      <p class="serif hx-sub ha4">{{ section.settings.subheadline }}</p>

      <div class="hx-ctas ha5">
        {% if featured_product.available and featured_product.has_only_default_variant %}
          <form method="post" action="{{ routes.cart_add_url }}" class="hx-form">
            <input type="hidden" name="id" value="{{ fp_variant.id }}">
            <input type="hidden" name="quantity" value="1">
            <button type="submit" class="hx-btn">Ajouter au panier <span class="hx-btn-sep"></span> {{ fp_variant.price | money }}</button>
          </form>
        {% elsif featured_product.available %}
          <a href="{{ featured_product.url }}" class="hx-btn">Choisir <span class="hx-btn-sep"></span> {{ fp_variant.price | money }}</a>
        {% endif %}
        <a href="#collection" class="hx-link">Découvrir les bijoux</a>
      </div>

      {% if proof.size > 0 %}
        <ul class="hx-proof ha6">
          {% for p in proof %}<li>{{ p | strip }}</li>{% endfor %}
        </ul>
      {% endif %}
    </div>
  </div>
</section>

<style>
.hx { position: relative; min-height: min(100svh, 920px); display: flex; align-items: flex-end; overflow: hidden; background: #0F3027; color: #FBF8F2; }
.hx-media, .hx-shade { position: absolute; inset: 0; }
.hx-video, .hx-poster { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.hx-poster { object-position: 62% 30%; }
.hx-shade { background: linear-gradient(180deg, rgba(11,36,29,.35) 0%, rgba(11,36,29,0) 28%, rgba(11,36,29,0) 50%, rgba(11,36,29,.82) 100%), linear-gradient(90deg, rgba(11,36,29,.5) 0%, rgba(11,36,29,0) 55%); }
.hx-inner { position: relative; width: 100%; max-width: 1280px; margin: 0 auto; padding: 140px clamp(20px, 5vw, 56px) clamp(48px, 8vh, 88px); }
.hx-copy { max-width: 560px; display: flex; flex-direction: column; align-items: flex-start; gap: 18px; }
.hx-eyebrow { font-family: 'Manrope', 'Helvetica Neue', Arial, sans-serif; font-size: 12px; font-weight: 500; letter-spacing: .16em; text-transform: uppercase; color: #E9DFC9; }
.hx-title { margin: 0; font-size: clamp(48px, 7.6vw, 96px); font-weight: 300; line-height: .98; letter-spacing: -.02em; color: #FBF8F2; }
.hx-sub { margin: 0; font-size: clamp(19px, 2.1vw, 23px); font-style: italic; font-weight: 400; line-height: 1.45; color: rgba(251,248,242,.9); max-width: 440px; }
.hx-ctas { display: flex; align-items: center; gap: 28px; flex-wrap: wrap; margin-top: 10px; }
.hx-form { margin: 0; }
.hx-btn { display: inline-flex; align-items: center; gap: 14px; min-height: 56px; padding: 0 30px; background: #FBF8F2; color: #0F3027; border: 0; font-family: 'Manrope', 'Helvetica Neue', Arial, sans-serif; font-size: 13px; font-weight: 600; letter-spacing: .06em; cursor: pointer; transition: background .3s ease; white-space: nowrap; }
.hx-btn:hover { background: #E9DFC9; }
.hx-btn-sep { width: 1px; height: 16px; background: rgba(15,48,39,.3); }
.hx-link { font-family: 'Manrope', 'Helvetica Neue', Arial, sans-serif; font-size: 13px; font-weight: 500; letter-spacing: .04em; color: #FBF8F2; border-bottom: 1px solid rgba(251,248,242,.5); padding-bottom: 3px; transition: border-color .25s ease; }
.hx-link:hover { border-color: #FBF8F2; }
.hx-proof { list-style: none; margin: 14px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 0; font-family: 'Manrope', 'Helvetica Neue', Arial, sans-serif; font-size: 12.5px; font-weight: 400; color: rgba(251,248,242,.85); }
.hx-proof li + li::before { content: ''; display: inline-block; width: 1px; height: 11px; background: rgba(251,248,242,.4); margin: 0 14px; vertical-align: -1px; }
@media (max-width: 560px) {
  .hx-inner { padding-bottom: 36px; }
  .hx-copy { gap: 14px; }
  .hx-ctas { width: 100%; gap: 18px; }
  .hx-form, .hx-btn { width: 100%; justify-content: center; }
  .hx-link { margin: 0 auto; }
  .hx-proof { font-size: 11.5px; justify-content: center; width: 100%; }
  .hx-proof li + li::before { margin: 0 9px; }
}
@media (prefers-reduced-motion: reduce) { .hx-video { display: none; } }
</style>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "product", "id": "product", "label": "Pièce mise en avant" },
    { "type": "video", "id": "video", "label": "Vidéo de fond", "info": "Facultatif. Par défaut : le film de la Maison. Format conseillé : MP4, 10 à 20 s, sans son." },
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Le collier signature" },
    { "type": "text", "id": "headline", "label": "Titre principal", "default": "La Goutte d’Émeraude" },
    { "type": "text", "id": "subheadline", "label": "Sous-titre", "default": "Un vert profond, cerclé de lumière. Celui qu’on ne quitte plus." },
    { "type": "text", "id": "proof", "label": "Réassurance (séparée par |)", "default": "Livré en écrin|Expédié sous 48 h ouvrées|Retours 30 jours" }
  ]
}
{% endschema %}
