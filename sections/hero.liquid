{% assign featured_product = section.settings.product | default: collections.all.products.first %}

<div style="width: 100%; position: relative; min-height: 100vh; display: flex; align-items: center; justify-content: center; overflow: hidden; background: #17140F;">
  <img
    src="{{ 'paris.jpg' | asset_url }}"
    alt="Collier La Goutte d'Émeraude — Maison L'Émeraude, bijou fin avec cristal vert et chaîne dorée"
    width="1920"
    height="1080"
    style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 62% 30%;"
    loading="eager"
    fetchpriority="high"
  >
  <div style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(23,20,15,.32) 0%, rgba(23,20,15,.04) 38%, rgba(23,20,15,.08) 55%, rgba(23,20,15,.76) 100%);"></div>

  <div style="position: relative; text-align: center; padding: 0 clamp(20px, 6vw, 60px); max-width: 700px; display: flex; flex-direction: column; align-items: center; gap: 20px;">
    <span class="eyebrow ha1" style="color: rgba(176,141,87,.92); font-size: 10px; letter-spacing: .32em;">{{ section.settings.brand_name | default: "Maison L'Émeraude" }}</span>
    <span class="ha2" style="display: block; width: 28px; height: 1px; background: rgba(176,141,87,.65); margin: 0 auto;"></span>
    <h1 class="serif hero-title ha3" style="margin: 0; line-height: 1.06; color: #FBF8F2;">{{ section.settings.headline | default: "La Goutte d'Émeraude" }}</h1>
    <p class="serif ha4" style="margin: 0; font-size: clamp(15px, 2vw, 19px); font-style: italic; line-height: 1.65; color: rgba(251,248,242,.82); max-width: 400px; font-weight: 300;">{{ section.settings.subheadline | default: "Un bijou imaginé pour capter la lumière." }}</p>
    <div class="ha5" style="display: flex; gap: 20px; margin-top: 14px; flex-wrap: wrap; justify-content: center; align-items: center;">
      <a href="{{ featured_product.url | default: '#piece' }}" class="btn btn-light" style="min-width: 190px;">Découvrir la pièce</a>
    </div>
    <a href="#offre" class="sans ha6" style="font-size: 10px; letter-spacing: .18em; text-transform: uppercase; color: rgba(251,248,242,.68); border-bottom: 1px solid rgba(251,248,242,.22); padding-bottom: 2px; margin-top: 2px; transition: color .25s ease, border-color .25s ease;">Offre de lancement — 1 acheté · 1 offert</a>
  </div>
</div>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "product", "id": "product", "label": "Pièce mise en avant" },
    { "type": "text", "id": "brand_name", "label": "Nom de la Maison", "default": "Maison L'Émeraude" },
    { "type": "text", "id": "headline", "label": "Titre principal", "default": "La Goutte d'Émeraude" },
    { "type": "text", "id": "subheadline", "label": "Sous-titre", "default": "Un bijou imaginé pour capter la lumière." }
  ]
}
{% endschema %}
