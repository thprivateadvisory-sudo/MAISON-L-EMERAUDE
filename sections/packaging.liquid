<div class="sect" style="width: 100%; background: #F3EEE3;">
  <div style="max-width: 1280px; margin: 0 auto;" class="grid-2">
    <div style="display: flex; flex-direction: column; gap: 20px;">
      <span class="sans" style="font-size: 12px; letter-spacing: .18em; text-transform: uppercase; color: #B08D57;">L'expérience</span>
      <h3 class="serif" style="margin: 0; font-size: clamp(24px, 4vw, 32px); line-height: 1.25; font-weight: 420;">Votre écrin vous attend</h3>
      <p class="sans" style="margin: 0; font-size: 15.5px; line-height: 1.8; color: #4A463D;">Du premier regard à l'ouverture de l'écrin, chaque détail doit prolonger l'expérience. La pièce est protégée, présentée, prête à être offerte.</p>
      <div class="sans" style="display: flex; flex-direction: column; gap: 14px; margin-top: 8px; font-size: 14.5px; color: #17140F;">
        <div style="display: flex; gap: 14px; align-items: baseline;"><span class="serif" style="color: #B08D57; font-style: italic;">01</span><span>Votre commande est préparée</span></div>
        <div style="display: flex; gap: 14px; align-items: baseline;"><span class="serif" style="color: #B08D57; font-style: italic;">02</span><span>Votre pièce est soigneusement protégée</span></div>
        <div style="display: flex; gap: 14px; align-items: baseline;"><span class="serif" style="color: #B08D57; font-style: italic;">03</span><span>Votre colis est expédié</span></div>
        <div style="display: flex; gap: 14px; align-items: baseline;"><span class="serif" style="color: #B08D57; font-style: italic;">04</span><span>Votre écrin arrive chez vous</span></div>
      </div>
    </div>
    <div style="width: 100%; aspect-ratio: 4 / 5; overflow: hidden;">
      {% if section.settings.image %}
        <img src="{{ section.settings.image | image_url: width: 900 }}" alt="Le collier L'Émeraude dans son écrin" style="width: 100%; height: 100%; object-fit: cover;">
      {% else %}
        <img src="{{ 'ecrin.png' | asset_url }}" alt="Le collier L'Émeraude dans son écrin" style="width: 100%; height: 100%; object-fit: cover; object-position: center top;">
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Packaging",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo de l'écrin" }
  ]
}
{% endschema %}
