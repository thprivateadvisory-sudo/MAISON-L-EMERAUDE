{% assign featured_product = section.settings.product | default: collections.all.products.first %}
{% assign img1 = featured_product.images[0] %}
{% assign img2 = featured_product.images[1] %}

<div id="piece" style="width: 100%; background: #FBF8F2;">
  <div style="max-width: 1280px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; min-height: 640px;" class="piece-discover-grid">

    <!-- Galerie photos produit -->
    <div class="piece-gallery" style="display: grid; grid-template-rows: 1.45fr 1fr; gap: 3px; overflow: hidden;">

      <!-- Photo 1 : portée (lifestyle) -->
      <div style="overflow: hidden; position: relative;">
        {% if img1 %}
          <img
            src="{{ img1 | image_url: width: 900 }}"
            srcset="{{ img1 | image_url: width: 600 }} 600w, {{ img1 | image_url: width: 900 }} 900w"
            sizes="(max-width: 860px) 100vw, 50vw"
            alt="{{ img1.alt | default: featured_product.title }}"
            style="width: 100%; height: 100%; object-fit: cover; object-position: center 20%; display: block; transition: transform .6s ease;"
            loading="lazy"
            onmouseover="this.style.transform='scale(1.025)'"
            onmouseout="this.style.transform='scale(1)'">
        {% else %}
          <img src="{{ 'necklace_full.jpg' | asset_url }}" alt="{{ featured_product.title | default: 'La Goutte d\'Émeraude' }}" style="width: 100%; height: 100%; object-fit: cover; display: block;">
        {% endif %}
      </div>

      <!-- Photo 2 : écrin / packaging -->
      <div style="overflow: hidden; position: relative;">
        {% if img2 %}
          <img
            src="{{ img2 | image_url: width: 900 }}"
            srcset="{{ img2 | image_url: width: 600 }} 600w, {{ img2 | image_url: width: 900 }} 900w"
            sizes="(max-width: 860px) 100vw, 50vw"
            alt="{{ img2.alt | default: 'Écrin Maison L\'Émeraude' }}"
            style="width: 100%; height: 100%; object-fit: cover; object-position: center; display: block; transition: transform .6s ease;"
            loading="lazy"
            onmouseover="this.style.transform='scale(1.025)'"
            onmouseout="this.style.transform='scale(1)'">
        {% elsif img1 %}
          <img
            src="{{ img1 | image_url: width: 900 }}"
            alt="{{ img1.alt | default: featured_product.title }}"
            style="width: 100%; height: 100%; object-fit: cover; display: block;">
        {% else %}
          <img src="{{ 'ecrin.png' | asset_url }}" alt="Écrin Maison L'Émeraude" style="width: 100%; height: 100%; object-fit: cover; display: block;">
        {% endif %}
      </div>

    </div>

    <!-- Texte + CTA -->
    <div style="display: flex; flex-direction: column; justify-content: center; gap: 28px; padding: clamp(48px, 7vw, 96px) clamp(32px, 5.5vw, 80px);">
      <span class="eyebrow" style="color: #B08D57; font-size: 10.5px;">La pièce signature</span>
      <span class="ornament" style="margin: 0;"></span>
      <h2 class="serif" style="margin: 0; font-size: clamp(26px, 3.8vw, 42px); line-height: 1.12; font-weight: 300; letter-spacing: -.008em;">{{ featured_product.title | default: "La Goutte d'Émeraude" }}</h2>
      <p class="sans" style="margin: 0; font-size: 13.5px; font-weight: 300; line-height: 2; letter-spacing: .02em; color: #4A463D; max-width: 340px;">{{ section.settings.description | default: "Une goutte d'émeraude sertie d'un halo de zircons blancs, suspendue à une chaîne fine en acier doré. Chaque pièce part dans son écrin signature." }}</p>

      <div style="display: flex; align-items: baseline; gap: 10px;">
        {% if featured_product %}
          {% if featured_product.compare_at_price > featured_product.price %}
            <span class="compare-price">{{ featured_product.compare_at_price | money }}</span>
          {% endif %}
          <span class="price">{{ featured_product.price | money }}</span>
        {% endif %}
      </div>

      {% if featured_product %}
        <div style="display: flex; flex-direction: column; gap: 16px; align-items: flex-start;">
          <a href="{{ featured_product.url }}" class="btn">Découvrir & commander</a>
          <div style="display: flex; flex-direction: column; gap: 7px;">
            <span class="sans" style="font-size: 11px; font-weight: 300; letter-spacing: .05em; color: #9c968a; display: flex; align-items: center; gap: 7px;">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#B08D57" stroke-width="1.5"><rect x="4" y="10" width="16" height="10" rx="1.5"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
              Paiement sécurisé
            </span>
            <span class="sans" style="font-size: 11px; font-weight: 300; letter-spacing: .05em; color: #9c968a; display: flex; align-items: center; gap: 7px;">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#B08D57" stroke-width="1.5"><path d="M3 7h11v10H3z"/><path d="M14 10h4l3 3v4h-7z"/><circle cx="7.5" cy="18.5" r="1.5"/><circle cx="17.5" cy="18.5" r="1.5"/></svg>
              Livraison suivie · Retours 30 jours
            </span>
            <span class="sans" style="font-size: 11px; font-weight: 300; letter-spacing: .05em; color: #9c968a; display: flex; align-items: center; gap: 7px;">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#B08D57" stroke-width="1.5"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 1 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              Écrin signature inclus
            </span>
          </div>
        </div>
      {% endif %}
    </div>

  </div>
</div>

<style>
  @media (max-width: 860px) {
    .piece-discover-grid { grid-template-columns: 1fr !important; }
    .piece-gallery { grid-template-rows: 1fr 1fr !important; min-height: 520px; }
  }
</style>

{% schema %}
{
  "name": "Présentation de la pièce",
  "settings": [
    { "type": "product", "id": "product", "label": "Pièce mise en avant" },
    { "type": "textarea", "id": "description", "label": "Description courte" }
  ]
}
{% endschema %}
