{% assign featured_product = section.settings.product | default: collections.all.products.first %}

<div id="piece" style="width: 100%; background: #FBF8F2;">
  <div style="max-width: 1280px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; min-height: 640px;" class="piece-discover-grid">

    <!-- Galerie avec vignettes -->
    <div style="display: flex; flex-direction: column; gap: 0; background: #F3EEE3;">

      <!-- Image principale -->
      <div style="overflow: hidden; flex: 1;">
        {% if featured_product and featured_product.images.size > 0 %}
          <img
            src="{{ featured_product.images[0] | image_url: width: 1000 }}"
            id="HomeGalleryMain"
            alt="{{ featured_product.images[0].alt | default: featured_product.title }}"
            style="width: 100%; height: 100%; object-fit: cover; object-position: center 20%; display: block; transition: opacity .25s ease; min-height: 480px;"
            loading="lazy"
          >
        {% else %}
          <img
            src="{{ 'necklace_full.jpg' | asset_url }}"
            id="HomeGalleryMain"
            alt="La Goutte d'Émeraude"
            style="width: 100%; height: 100%; object-fit: cover; display: block; min-height: 480px;"
            loading="lazy"
          >
        {% endif %}
      </div>

      <!-- Vignettes -->
      {% if featured_product and featured_product.images.size > 1 %}
        <div style="display: flex; gap: 3px; background: #FBF8F2; padding: 3px 0 0 0;" id="HomeGalleryThumbs">
          {% for image in featured_product.images limit: 4 %}
            <div
              style="flex: 1; aspect-ratio: 1; overflow: hidden; cursor: pointer; opacity: {% if forloop.first %}1{% else %}.62{% endif %}; transition: opacity .2s ease;"
              class="home-thumb{% if forloop.first %} home-thumb-active{% endif %}"
              data-full="{{ image | image_url: width: 1000 }}"
              onclick="homeGallerySwap(this)"
            >
              <img
                src="{{ image | image_url: width: 300 }}"
                alt="{{ image.alt | default: featured_product.title }}"
                style="width: 100%; height: 100%; object-fit: cover; display: block; pointer-events: none;"
                loading="lazy"
              >
            </div>
          {% endfor %}
        </div>
      {% endif %}

    </div>

    <!-- Texte + CTA -->
    <div style="display: flex; flex-direction: column; justify-content: center; gap: 28px; padding: clamp(48px, 7vw, 96px) clamp(32px, 5.5vw, 80px);">
      <span class="eyebrow" style="color: #B08D57; font-size: 10px; letter-spacing: .28em;">La pièce signature</span>
      <span class="ornament" style="margin: 0;"></span>
      <h2 class="serif" style="margin: 0; font-size: clamp(26px, 3.8vw, 42px); line-height: 1.12; font-weight: 300; letter-spacing: -.008em;">{{ featured_product.title | default: "La Goutte d'Émeraude" }}</h2>
      <p class="sans" style="margin: 0; font-size: 13.5px; font-weight: 300; line-height: 2; letter-spacing: .02em; color: #4A463D; max-width: 340px;">{{ section.settings.description | default: "Une goutte d'émeraude entourée d'un halo de zircons blancs, suspendue à une chaîne fine en acier doré. La première pièce de la Maison." }}</p>

      <div style="display: flex; align-items: baseline; gap: 10px;">
        {% if featured_product %}
          {% if featured_product.compare_at_price > featured_product.price %}
            <span class="compare-price">{{ featured_product.compare_at_price | money }}</span>
          {% endif %}
          <span class="price">{{ featured_product.price | money }}</span>
        {% endif %}
      </div>

      {% if featured_product %}
        <div style="display: flex; flex-direction: column; gap: 16px; align-items: flex-start;">
          <a href="{{ featured_product.url }}" class="btn">Découvrir & commander</a>
          <div style="display: flex; flex-direction: column; gap: 7px;">
            <span class="trust-row">
              <svg class="trust-check" viewBox="0 0 24 24" fill="none" stroke="#B08D57" stroke-width="1.8"><polyline points="20 6 9 17 4 12"/></svg>
              Paiement sécurisé
            </span>
            <span class="trust-row">
              <svg class="trust-check" viewBox="0 0 24 24" fill="none" stroke="#B08D57" stroke-width="1.8"><polyline points="20 6 9 17 4 12"/></svg>
              Livraison suivie · Retours 30 jours
            </span>
            <span class="trust-row">
              <svg class="trust-check" viewBox="0 0 24 24" fill="none" stroke="#B08D57" stroke-width="1.8"><polyline points="20 6 9 17 4 12"/></svg>
              Écrin signature inclus
            </span>
          </div>
        </div>
      {% endif %}
    </div>

  </div>
</div>

<script>
function homeGallerySwap(el) {
  var main = document.getElementById('HomeGalleryMain');
  var thumbs = document.querySelectorAll('.home-thumb');
  var fullSrc = el.getAttribute('data-full');
  if (!main || !fullSrc) return;

  // Réinitialise l'opacité de toutes les vignettes
  thumbs.forEach(function(t) {
    t.style.opacity = '.62';
    t.classList.remove('home-thumb-active');
  });
  el.style.opacity = '1';
  el.classList.add('home-thumb-active');

  // Swap image principale
  main.style.opacity = '0';
  setTimeout(function() {
    main.removeAttribute('srcset');
    main.src = fullSrc;
    main.style.opacity = '1';
  }, 150);
}
</script>

<style>
@media (max-width: 860px) {
  .piece-discover-grid { grid-template-columns: 1fr !important; }
  #HomeGalleryMain { min-height: 320px !important; }
}
</style>

{% schema %}
{
  "name": "Présentation de la pièce",
  "settings": [
    { "type": "product", "id": "product", "label": "Pièce mise en avant" },
    { "type": "textarea", "id": "description", "label": "Description courte" }
  ]
}
{% endschema %}
