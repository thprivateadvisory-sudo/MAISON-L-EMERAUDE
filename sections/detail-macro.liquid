<div class="sect" style="width: 100%; padding-top: 0;">
  <div style="max-width: 1280px; margin: 0 auto;" class="grid-2">

    <div style="width: 100%; aspect-ratio: 4 / 5; overflow: hidden; background: #F3EEE3;">
      <img
        src="{{ 'closeup.jpg' | asset_url }}"
        srcset="{{ 'closeup-600.jpg' | asset_url }} 600w, {{ 'closeup.jpg' | asset_url }} 1000w"
        sizes="(max-width: 860px) 100vw, 50vw"
        width="1000"
        height="1200"
        alt="Gros plan du pendentif en cristal synthétique vert entouré d'un halo de pierres blanches"
        style="width: 100%; height: 100%; object-fit: cover; object-position: 50% 55%;"
        loading="lazy"
      >
    </div>

    <div style="display: flex; flex-direction: column; gap: 22px;">
      <span class="eyebrow" style="font-size: 10px; color: #7A5C2E; letter-spacing: .28em;">Le détail</span>
      <h2 class="serif" style="margin: 0; font-size: clamp(22px, 3.5vw, 30px); line-height: 1.25; font-weight: 300;">Une pierre taillée en goutte.</h2>
      <p class="sans" style="margin: 0; font-size: 14px; font-weight: 300; line-height: 1.9; color: #4A463D; letter-spacing: .015em;">La pierre centrale est un cristal synthétique vert, taillé en goutte et entouré d'un halo de pierres blanches. Elle rappelle le vert profond de l'émeraude, pour un prix bien plus doux qu'une pierre naturelle.</p>

      {% # Note de transparence %}
      <div style="background: rgba(27,24,18,.04); border-left: 2px solid #B08D57; padding: 14px 18px;">
        <p class="sans" style="margin: 0; font-size: 12.5px; font-weight: 300; line-height: 1.75; color: #4A463D; font-style: italic;">À noter : la pierre est un cristal synthétique, et non une émeraude naturelle.</p>
      </div>

      {% # Fiche matières %}
      <ul class="sans" style="list-style: none; margin: 8px 0 0; padding: 0; display: flex; flex-direction: column; gap: 0; font-size: 13.5px; color: #17140F;">
        <li style="display: flex; justify-content: space-between; gap: 12px; border-top: 1px solid rgba(27,24,18,.1); padding: 13px 0;">
          <span style="color: #6b6558; font-size: 10px; letter-spacing: .12em; text-transform: uppercase; font-family: 'Montserrat', sans-serif; font-weight: 400;">Pierre centrale</span>
          <span style="font-weight: 300; text-align: right; max-width: 60%;">{{ section.settings.stone | default: "Cristal synthétique vert, taille goutte" }}</span>
        </li>
        <li style="display: flex; justify-content: space-between; gap: 12px; border-top: 1px solid rgba(27,24,18,.1); padding: 13px 0;">
          <span style="color: #6b6558; font-size: 10px; letter-spacing: .12em; text-transform: uppercase; font-family: 'Montserrat', sans-serif; font-weight: 400;">Pierre secondaire</span>
          <span style="font-weight: 300; text-align: right; max-width: 60%;">{{ section.settings.secondary_stone | default: "Oxydes de zirconium blancs" }}</span>
        </li>
        <li style="display: flex; justify-content: space-between; gap: 12px; border-top: 1px solid rgba(27,24,18,.1); padding: 13px 0;">
          <span style="color: #6b6558; font-size: 10px; letter-spacing: .12em; text-transform: uppercase; font-family: 'Montserrat', sans-serif; font-weight: 400;">Métal</span>
          <span style="font-weight: 300; text-align: right; max-width: 60%;">{{ section.settings.metal | default: "Acier inoxydable, finition dorée à l'or fin" }}</span>
        </li>
        <li style="display: flex; justify-content: space-between; gap: 12px; border-top: 1px solid rgba(27,24,18,.1); padding: 13px 0; border-bottom: 1px solid rgba(27,24,18,.1);">
          <span style="color: #6b6558; font-size: 10px; letter-spacing: .12em; text-transform: uppercase; font-family: 'Montserrat', sans-serif; font-weight: 400;">Chaîne</span>
          <span style="font-weight: 300; text-align: right; max-width: 60%;">{{ section.settings.chain_length | default: "40 cm, rallonge jusqu'à 45 cm" }}</span>
        </li>
      </ul>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Gros plan produit",
  "settings": [
    { "type": "text", "id": "stone", "label": "Pierre centrale" },
    { "type": "text", "id": "secondary_stone", "label": "Pierre secondaire" },
    { "type": "text", "id": "metal", "label": "Métal" },
    { "type": "text", "id": "chain_length", "label": "Longueur de chaîne" }
  ]
}
{% endschema %}
