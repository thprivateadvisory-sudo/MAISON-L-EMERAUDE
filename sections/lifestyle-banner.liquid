<div style="width: 100%; position: relative; aspect-ratio: 16 / 9; overflow: hidden; max-height: 640px;">
  <img src="{{ 'paris.jpg' | asset_url }}" alt="Ambiance parisienne, le collier porté au coucher du soleil" style="width: 100%; height: 100%; object-fit: cover; object-position: 30% 15%;">
  <div style="position: absolute; inset: 0; background: linear-gradient(0deg, rgba(23,20,15,.5) 0%, rgba(23,20,15,0) 45%);"></div>
  <p class="serif" style="position: absolute; left: clamp(18px, 5vw, 40px); bottom: 24px; margin: 0; font-size: clamp(15px, 2vw, 18px); font-style: italic; color: #FBF8F2;">{{ section.settings.caption | default: "Paris, à l'heure où la lumière se fait douce." }}</p>
</div>

{% schema %}
{
  "name": "Bandeau lifestyle",
  "settings": [
    { "type": "text", "id": "caption", "label": "Légende" }
  ]
}
{% endschema %}
