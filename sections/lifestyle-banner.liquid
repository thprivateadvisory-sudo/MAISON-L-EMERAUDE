{% if section.settings.image != blank or section.settings.show_fallback %}
<div style="width: 100%; position: relative; aspect-ratio: 16 / 7; overflow: hidden; max-height: 520px; min-height: 260px; background: #17140F;">
  {% if section.settings.image %}
    <img
      src="{{ section.settings.image | image_url: width: 1600 }}"
      srcset="{{ section.settings.image | image_url: width: 800 }} 800w, {{ section.settings.image | image_url: width: 1200 }} 1200w, {{ section.settings.image | image_url: width: 1600 }} 1600w"
      sizes="100vw"
      alt="{{ section.settings.image.alt | default: 'Maison L\'Émeraude' }}"
      style="width: 100%; height: 100%; object-fit: cover; object-position: {{ section.settings.focal_point | default: '50% 50%' }};"
      loading="lazy"
    >
  {% else %}
    <!-- Bannière typographique quand pas d'image lifestyle disponible -->
    <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; min-height: 260px;">
      <span class="serif" style="font-size: clamp(18px, 4vw, 36px); font-style: italic; color: rgba(251,248,242,.3); letter-spacing: .08em; text-align: center; padding: 0 20px;">{{ section.settings.caption | default: "Une pièce. Un écrin. Une intention." }}</span>
    </div>
  {% endif %}
  {% if section.settings.image %}
    <div style="position: absolute; inset: 0; background: linear-gradient(0deg, rgba(23,20,15,.45) 0%, rgba(23,20,15,0) 40%);"></div>
    {% if section.settings.caption != blank %}
      <p class="serif" style="position: absolute; left: clamp(18px, 5vw, 40px); bottom: clamp(20px, 3vw, 32px); margin: 0; font-size: clamp(14px, 1.8vw, 17px); font-style: italic; color: rgba(251,248,242,.88);">{{ section.settings.caption }}</p>
    {% endif %}
  {% endif %}
</div>
{% endif %}

{% schema %}
{
  "name": "Bandeau lifestyle",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo lifestyle (à différencier du hero)" },
    { "type": "text", "id": "caption", "label": "Légende", "default": "Une pièce. Un écrin. Une intention." },
    { "type": "text", "id": "focal_point", "label": "Point focal (ex : 50% 30%)", "default": "50% 50%" },
    { "type": "checkbox", "id": "show_fallback", "label": "Afficher le bandeau même sans image", "default": false }
  ]
}
{% endschema %}
