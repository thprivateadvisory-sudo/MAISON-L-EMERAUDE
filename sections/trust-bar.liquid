<div class="tbar">
  <ul class="tbar-list">
    <li class="tbar-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="#0F3027" stroke-width="1.4" aria-hidden="true"><rect x="4" y="10" width="16" height="10" rx="1.5"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
      <span><span class="tbar-title">Paiement sécurisé</span><span class="tbar-sub">Carte bancaire, données chiffrées</span></span>
    </li>
    <li class="tbar-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="#0F3027" stroke-width="1.4" aria-hidden="true"><path d="M3 7h11v10H3z"/><path d="M14 10h4l3 3v4h-7z"/><circle cx="7.5" cy="18.5" r="1.5"/><circle cx="17.5" cy="18.5" r="1.5"/></svg>
      <span><span class="tbar-title">{% if settings.free_shipping %}Livraison offerte{% else %}Livraison suivie{% endif %}</span><span class="tbar-sub">Expédié sous {{ settings.prep_time }}</span></span>
    </li>
    <li class="tbar-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="#0F3027" stroke-width="1.4" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/></svg>
      <span><span class="tbar-title">Retours {{ settings.return_days }} jours</span><span class="tbar-sub">Remboursé si la pièce ne vous plaît pas</span></span>
    </li>
    <li class="tbar-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="#0F3027" stroke-width="1.4" aria-hidden="true"><rect x="3" y="8" width="18" height="13" rx="1"/><path d="M3 12h18M12 8v13"/><path d="M12 8c-1.5-3-5-3.5-5-1.2C7 8 12 8 12 8zM12 8c1.5-3 5-3.5 5-1.2C17 8 12 8 12 8z"/></svg>
      <span><span class="tbar-title">Écrin inclus</span><span class="tbar-sub">Prêt à offrir, sans prix dans le colis</span></span>
    </li>
  </ul>
</div>

{% schema %}
{
  "name": "Bandeau de confiance",
  "settings": [],
  "presets": [{ "name": "Bandeau de confiance" }]
}
{% endschema %}
