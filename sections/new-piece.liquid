{%- liquid
  # Nouveauté : produit choisi dans l'éditeur, sinon premières boucles d'oreilles de la boutique
  assign new_product = section.settings.product
  if new_product == blank
    for p in collections.all.products
      if p.title contains 'oreilles'
        assign new_product = p
        break
      endif
    endfor
  endif

  # Pièce à associer (collier) pour la mention « parure »
  assign pair_product = section.settings.pair_product
  if pair_product == blank
    for p in collections.all.products
      unless p.title contains 'oreilles'
        assign pair_product = p
        break
      endunless
    endfor
  endif
-%}

{%- if new_product -%}
<div id="nouveaute" class="np-section dark-grain">
  <div class="np-grid">

    <!-- Galerie -->
    <div class="np-gallery ml-reveal">
      <div class="np-main">
        <span class="np-badge">{{ section.settings.badge | default: 'Nouveauté' }}</span>
        {% if new_product.featured_image %}
          <img
            src="{{ new_product.featured_image | image_url: width: 1000 }}"
            srcset="{{ new_product.featured_image | image_url: width: 600 }} 600w, {{ new_product.featured_image | image_url: width: 1000 }} 1000w"
            sizes="(max-width: 860px) 100vw, 50vw"
            width="1000"
            height="{{ 1000 | divided_by: new_product.featured_image.aspect_ratio | round }}"
            id="NewPieceMain"
            alt="{{ new_product.featured_image.alt | default: new_product.title | escape }}"
            loading="lazy"
          >
        {% endif %}
      </div>
      {% if new_product.images.size > 1 %}
        <div class="np-thumbs">
          {% for image in new_product.images limit: 4 %}
            <button
              type="button"
              class="np-thumb{% if forloop.first %} active{% endif %}"
              data-full="{{ image | image_url: width: 1000 }}"
              aria-label="Afficher la photo {{ forloop.index }}"
              aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
            >
              <img src="{{ image | image_url: width: 240 }}" alt="" width="120" height="120" loading="lazy">
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <!-- Texte -->
    <div class="np-text">
      <span class="eyebrow ml-reveal" style="color: #C9A96E; font-size: 10px; letter-spacing: .28em;">{{ section.settings.eyebrow | default: 'Nouvelle pièce de la Maison' }}</span>
      <span class="ornament ml-reveal" style="margin: 0; background: #7A1F2B;"></span>
      <h2 class="serif ml-reveal ml-d1 np-title">{{ new_product.title }}</h2>
      <p class="serif ml-reveal ml-d1 np-tagline">{{ section.settings.tagline | default: 'Deux gouttes rouge profond, cerclées de lumière. Pour un regard qui ne passe pas inaperçu.' }}</p>
      <p class="sans ml-reveal ml-d2 np-desc">{{ section.settings.description | default: "Une pierre taillée en poire, couleur grenat, entourée d'un halo de pierres blanches et suspendue à une fine créole dorée sertie. Elles bougent avec vous, accrochent la lumière à chaque mouvement — et subliment aussi bien une tenue du soir qu'un simple col roulé." }}</p>

      <ul class="np-chips ml-reveal ml-d2">
        <li>Taille poire</li>
        <li>Halo scintillant</li>
        <li>Créoles dorées serties</li>
        <li>Écrin inclus</li>
      </ul>

      <div class="ml-reveal ml-d3" style="display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap;">
        {% if new_product.compare_at_price > new_product.price %}
          <span class="compare-price" style="color: rgba(251,248,242,.5);"><span class="visually-hidden">Prix de référence :</span>{{ new_product.compare_at_price | money }}</span>
        {% endif %}
        <span class="price" style="color: #FBF8F2;">{{ new_product.price | money }}</span>
        {% if settings.offer_active %}<span class="np-offer">1 achetée · 1 offerte</span>{% endif %}
      </div>

      <div class="ml-reveal ml-d3" style="display: flex; flex-direction: column; gap: 18px; align-items: flex-start;">
        <a href="{{ new_product.url }}" class="btn btn-light np-cta">{{ section.settings.cta | default: 'Découvrir les boucles' }}</a>
        <div style="display: flex; flex-direction: column; gap: 7px;">
          <span class="trust-row" style="color: rgba(251,248,242,.66);">
            <svg class="trust-check" viewBox="0 0 24 24" fill="none" stroke="#C9A96E" stroke-width="1.8"><polyline points="20 6 9 17 4 12"/></svg>
            Paiement sécurisé · Livraison suivie
          </span>
          <span class="trust-row" style="color: rgba(251,248,242,.66);">
            <svg class="trust-check" viewBox="0 0 24 24" fill="none" stroke="#C9A96E" stroke-width="1.8"><polyline points="20 6 9 17 4 12"/></svg>
            Retours {{ settings.return_days }} jours · Écrin signature prêt à offrir
          </span>
        </div>
      </div>

      {% if pair_product and pair_product.id != new_product.id %}
        <a href="{{ pair_product.url }}" class="np-pair ml-reveal ml-d4">
          {% if pair_product.featured_image %}
            <img src="{{ pair_product.featured_image | image_url: width: 160 }}" alt="" width="56" height="56" loading="lazy">
          {% endif %}
          <span>
            <span class="np-pair-label">Composez votre parure</span>
            <span class="np-pair-name">Associez-les à {{ pair_product.title }} →</span>
          </span>
        </a>
      {% endif %}
    </div>

  </div>
</div>

<script>
(function() {
  var main = document.getElementById('NewPieceMain');
  var thumbs = document.querySelectorAll('.np-thumb');
  thumbs.forEach(function(t) {
    t.addEventListener('click', function() {
      var src = t.getAttribute('data-full');
      if (!main || !src) return;
      thumbs.forEach(function(o) { o.classList.remove('active'); o.setAttribute('aria-pressed', 'false'); });
      t.classList.add('active');
      t.setAttribute('aria-pressed', 'true');
      main.style.opacity = '0';
      setTimeout(function() {
        main.removeAttribute('srcset');
        main.removeAttribute('sizes');
        main.src = src;
        main.style.opacity = '1';
      }, 150);
    });
  });
})();
</script>
{%- endif -%}

<style>
.np-section { width: 100%; background: #17140F; color: #FBF8F2; padding: clamp(64px, 10vw, 128px) clamp(18px, 5vw, 36px); }
.np-section::after { content: ''; position: absolute; inset: 0; pointer-events: none; z-index: 0; background: radial-gradient(ellipse 60% 55% at 22% 45%, rgba(122,31,43,.34), transparent 70%); }
.np-grid { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(36px, 6vw, 88px); align-items: center; }
.np-main { position: relative; overflow: hidden; background: #F3EEE3; aspect-ratio: 4 / 5; }
.np-main img { width: 100%; height: 100%; object-fit: cover; transition: transform .8s cubic-bezier(.25,.46,.45,.94), opacity .25s ease; }
.np-main:hover img { transform: scale(1.04); }
.np-badge { position: absolute; top: clamp(14px, 2vw, 20px); left: clamp(14px, 2vw, 20px); z-index: 1; padding: 8px 14px; background: #7A1F2B; color: #FBF8F2; font-family: 'Montserrat', sans-serif; font-size: 9px; font-weight: 400; letter-spacing: .24em; text-transform: uppercase; }
.np-thumbs { display: flex; gap: 8px; margin-top: 8px; }
.np-thumb { flex: 1; max-width: 96px; aspect-ratio: 1; padding: 0; border: 1px solid transparent; background: #F3EEE3; cursor: pointer; opacity: .6; transition: opacity .2s ease, border-color .2s ease; }
.np-thumb img { width: 100%; height: 100%; object-fit: cover; pointer-events: none; }
.np-thumb.active, .np-thumb:hover { opacity: 1; border-color: #C9A96E; }
.np-text { display: flex; flex-direction: column; gap: 22px; }
.np-title { margin: 0; font-size: clamp(30px, 4.4vw, 50px); line-height: 1.08; font-weight: 300; letter-spacing: -.01em; color: #FBF8F2; }
.np-tagline { margin: -6px 0 0; font-size: clamp(17px, 2vw, 21px); font-style: italic; font-weight: 300; line-height: 1.5; color: rgba(251,248,242,.86); max-width: 440px; }
.np-desc { margin: 0; font-size: 13.5px; font-weight: 300; line-height: 1.95; letter-spacing: .02em; color: rgba(251,248,242,.68); max-width: 440px; }
.np-chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
.np-chips li { font-family: 'Montserrat', sans-serif; font-size: 9.5px; letter-spacing: .16em; text-transform: uppercase; color: rgba(251,248,242,.8); border: 1px solid rgba(201,169,110,.35); padding: 8px 12px; }
.np-offer { font-family: 'Montserrat', sans-serif; font-size: 9.5px; letter-spacing: .18em; text-transform: uppercase; color: #C9A96E; border-left: 1px solid rgba(201,169,110,.4); padding-left: 10px; margin-left: 4px; }
.np-cta { min-width: 230px; text-align: center; }
.np-pair { display: flex; align-items: center; gap: 14px; margin-top: 6px; padding: 14px 16px; border: 1px solid rgba(251,248,242,.12); max-width: 440px; transition: border-color .25s ease, background .25s ease; }
.np-pair:hover { border-color: rgba(201,169,110,.5); background: rgba(251,248,242,.03); }
.np-pair img { width: 56px; height: 56px; object-fit: cover; flex-shrink: 0; }
.np-pair > span { display: flex; flex-direction: column; gap: 4px; }
.np-pair-label { font-family: 'Montserrat', sans-serif; font-size: 9px; letter-spacing: .22em; text-transform: uppercase; color: #C9A96E; }
.np-pair-name { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 17px; color: #FBF8F2; }
@media (max-width: 860px) {
  .np-grid { grid-template-columns: 1fr; }
  .np-cta { width: 100%; }
}
@media (prefers-reduced-motion: reduce) {
  .np-main img { transition: opacity .25s ease; }
  .np-main:hover img { transform: none; }
}
</style>

{% schema %}
{
  "name": "Nouveauté",
  "settings": [
    { "type": "product", "id": "product", "label": "Pièce mise en avant", "info": "Par défaut : les boucles d'oreilles de la boutique." },
    { "type": "product", "id": "pair_product", "label": "Pièce à associer (parure)" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "Nouveauté" },
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Nouvelle pièce de la Maison" },
    { "type": "textarea", "id": "tagline", "label": "Accroche" },
    { "type": "textarea", "id": "description", "label": "Description" },
    { "type": "text", "id": "cta", "label": "Texte du bouton", "default": "Découvrir les boucles" }
  ],
  "presets": [{ "name": "Nouveauté" }]
}
{% endschema %}
