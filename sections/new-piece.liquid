{%- capture piece_handles -%}{% render 'piece-handles' %}{%- endcapture -%}
{%- liquid
  assign piece_handles = piece_handles | split: '|'
  assign piece_necklace = all_products[piece_handles[0]]
  assign piece_earrings = all_products[piece_handles[1]]
  assign piece_bracelet = all_products[piece_handles[2]]

  # Nouveauté : produit choisi dans l'éditeur, sinon le bracelet, sinon les boucles d'oreilles
  assign new_product = section.settings.product
  if new_product == blank
    if piece_bracelet.id
      assign new_product = piece_bracelet
    elsif piece_earrings.id
      assign new_product = piece_earrings
    endif
  endif

  assign np_kind = new_product.title | append: ' ' | append: new_product.type | downcase
  if np_kind contains 'bracelet'
    assign default_tagline = 'La nouvelle pièce de la Maison, à porter seule ou en parure.'
    assign default_chips = 'Se porte seul ou en parure,Écrin inclus,Prêt à offrir'
    assign default_cta = 'Découvrir le bracelet'
  else
    assign default_tagline = 'Deux gouttes rouge grenat, entourées de pierres blanches.'
    assign default_chips = 'Taille poire,Halo scintillant,Créoles dorées serties,Écrin inclus'
    assign default_cta = 'Découvrir les boucles'
  endif
  assign default_description = new_product.description | strip_html | truncatewords: 45

  assign chips = section.settings.chips | default: default_chips | split: ','
-%}

{%- if new_product -%}
<div id="nouveaute" class="np-section">
  <div class="np-grid">

    {% # Galerie %}
    <div class="np-gallery ml-reveal">
      <div class="np-main">
        <span class="np-badge">{{ section.settings.badge | default: 'Nouveauté' }}</span>
        {% if new_product.featured_image %}
          <img
            src="{{ new_product.featured_image | image_url: width: 1000 }}"
            srcset="{{ new_product.featured_image | image_url: width: 600 }} 600w, {{ new_product.featured_image | image_url: width: 1000 }} 1000w"
            sizes="(max-width: 860px) 100vw, 50vw"
            width="1000"
            height="{{ 1000 | divided_by: new_product.featured_image.aspect_ratio | round }}"
            id="NewPieceMain"
            alt="{{ new_product.featured_image.alt | default: new_product.title | escape }}"
            loading="lazy"
          >
        {% endif %}
      </div>
      {% if new_product.images.size > 1 %}
        <div class="np-thumbs">
          {% for image in new_product.images limit: 4 %}
            <button
              type="button"
              class="np-thumb{% if forloop.first %} active{% endif %}"
              data-full="{{ image | image_url: width: 1000 }}"
              aria-label="Afficher la photo {{ forloop.index }}"
              aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
            >
              <img src="{{ image | image_url: width: 240 }}" alt="" width="120" height="120" loading="lazy">
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    {% # Texte %}
    <div class="np-text">
      <span class="eyebrow ml-reveal" style="color: #155E48; font-size: 11px; letter-spacing: .16em;">{{ section.settings.eyebrow | default: 'Nouvelle pièce de la Maison' }}</span>
      <span class="ornament ml-reveal" style="margin: 0; background: #155E48;"></span>
      <h2 class="serif ml-reveal ml-d1 np-title">{{ new_product.title | replace: "'", "’" }}</h2>
      <p class="serif ml-reveal ml-d1 np-tagline">{{ section.settings.tagline | default: default_tagline }}</p>
      <p class="sans ml-reveal ml-d2 np-desc">{{ section.settings.description | default: default_description }}</p>

      <ul class="np-chips ml-reveal ml-d2">
        {% for chip in chips %}<li>{{ chip | strip }}</li>{% endfor %}
      </ul>

      <div class="ml-reveal ml-d3" style="display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap;">
        {% if new_product.compare_at_price > new_product.price %}
          <span class="compare-price"><span class="visually-hidden">Prix de référence :</span>{{ new_product.compare_at_price | money }}</span>
        {% endif %}
        <span class="price">{{ new_product.price | money }}</span>
      </div>

      <div class="ml-reveal ml-d3" style="display: flex; flex-direction: column; gap: 18px; align-items: flex-start;">
        <a href="{{ new_product.url }}" class="btn btn-dark np-cta">{{ section.settings.cta | default: default_cta }}</a>
        <div style="display: flex; flex-direction: column; gap: 7px;">
          <span class="trust-row">
            <svg class="trust-check" viewBox="0 0 24 24" fill="none" stroke="#B08D57" stroke-width="1.8"><polyline points="20 6 9 17 4 12"/></svg>
            Paiement sécurisé · Livraison suivie
          </span>
          <span class="trust-row">
            <svg class="trust-check" viewBox="0 0 24 24" fill="none" stroke="#B08D57" stroke-width="1.8"><polyline points="20 6 9 17 4 12"/></svg>
            Retours {{ settings.return_days }} jours · Écrin prêt à offrir
          </span>
        </div>
      </div>

      {% if piece_necklace.id and piece_earrings.id and piece_bracelet.id and settings.trio_active %}
        <a href="#parure" class="pdp-pair ml-reveal ml-d4" style="max-width: 480px;">
          <span style="display: flex; flex-direction: column; gap: 4px; min-width: 0;">
            <span class="eyebrow" style="font-size: 10.5px; color: #7A5C2E;">Parure complète</span>
            <span class="serif" style="font-size: 17px; color: #17140F;">Collier + boucles + bracelet : −{{ settings.trio_percent }} %</span>
          </span>
          <span aria-hidden="true" style="margin-left: auto; color: #B08D57; font-size: 18px;">→</span>
        </a>
      {% elsif new_product.id == piece_earrings.id and piece_necklace.id %}
        <div class="ml-reveal ml-d4" style="max-width: 480px;">
          {% render 'bundle-offer', mode: 'duo', piece_a: piece_earrings, piece_b: piece_necklace %}
        </div>
      {% endif %}
    </div>

  </div>
</div>

<script>
(function() {
  var main = document.getElementById('NewPieceMain');
  var thumbs = document.querySelectorAll('.np-thumb');
  thumbs.forEach(function(t) {
    t.addEventListener('click', function() {
      var src = t.getAttribute('data-full');
      if (!main || !src) return;
      thumbs.forEach(function(o) { o.classList.remove('active'); o.setAttribute('aria-pressed', 'false'); });
      t.classList.add('active');
      t.setAttribute('aria-pressed', 'true');
      main.style.opacity = '0';
      setTimeout(function() {
        main.removeAttribute('srcset');
        main.removeAttribute('sizes');
        main.src = src;
        main.style.opacity = '1';
      }, 150);
    });
  });
})();
</script>
{%- endif -%}

<style>
.np-section { width: 100%; background: #FBF8F2; color: #17140F; padding: clamp(64px, 10vw, 128px) clamp(18px, 5vw, 36px); border-top: 1px solid rgba(27,24,18,.07); }
.np-grid { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(36px, 6vw, 88px); align-items: center; }
.np-main { position: relative; overflow: hidden; background: #FFFFFF; aspect-ratio: 1 / 1; }
.np-main img { width: 100%; height: 100%; object-fit: cover; object-position: center; transition: transform .8s cubic-bezier(.25,.46,.45,.94), opacity .25s ease; }
.np-main:hover img { transform: scale(1.04); }
.np-badge { position: absolute; top: clamp(14px, 2vw, 20px); left: clamp(14px, 2vw, 20px); z-index: 1; padding: 8px 14px; background: #155E48; color: #FBF8F2; font-family: 'Manrope', 'Helvetica Neue', Arial, sans-serif; font-size: 10.5px; font-weight: 400; letter-spacing: .16em; text-transform: uppercase; }
.np-thumbs { display: flex; gap: 8px; margin-top: 8px; }
.np-thumb { flex: 1; max-width: 96px; aspect-ratio: 1; padding: 0; border: 1px solid rgba(27,24,18,.12); background: #FFFFFF; cursor: pointer; opacity: .6; transition: opacity .2s ease, border-color .2s ease; }
.np-thumb img { width: 100%; height: 100%; object-fit: cover; pointer-events: none; }
.np-thumb.active, .np-thumb:hover { opacity: 1; border-color: #B08D57; }
.np-text { display: flex; flex-direction: column; gap: 22px; }
.np-title { margin: 0; font-size: clamp(30px, 4.4vw, 50px); line-height: 1.08; font-weight: 300; letter-spacing: -.01em; color: #17140F; }
.np-tagline { margin: -6px 0 0; font-size: clamp(17px, 2vw, 21px); font-style: italic; font-weight: 300; line-height: 1.5; color: #4A463D; max-width: 440px; }
.np-desc { margin: 0; font-size: 15px; font-weight: 300; line-height: 1.95; letter-spacing: .02em; color: #4A463D; max-width: 440px; }
.np-chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
.np-chips li { font-family: 'Manrope', 'Helvetica Neue', Arial, sans-serif; font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: #17140F; border: 1px solid rgba(176,141,87,.35); padding: 8px 12px; }
.np-offer { font-family: 'Manrope', 'Helvetica Neue', Arial, sans-serif; font-size: 11px; letter-spacing: .18em; text-transform: uppercase; color: #155E48; border-left: 1px solid rgba(176,141,87,.4); padding-left: 10px; margin-left: 4px; }
.np-cta { min-width: 230px; text-align: center; }
@media (max-width: 860px) {
  .np-grid { grid-template-columns: 1fr; }
  .np-cta { width: 100%; }
}
@media (prefers-reduced-motion: reduce) {
  .np-main img { transition: opacity .25s ease; }
  .np-main:hover img { transform: none; }
}
</style>

{% schema %}
{
  "name": "Nouveauté",
  "settings": [
    { "type": "product", "id": "product", "label": "Pièce mise en avant", "info": "Par défaut : le bracelet de la boutique." },
    { "type": "text", "id": "badge", "label": "Badge", "default": "Nouveauté" },
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Nouvelle pièce de la Maison" },
    { "type": "textarea", "id": "tagline", "label": "Accroche" },
    { "type": "textarea", "id": "description", "label": "Description", "info": "Par défaut : le début de la description du produit." },
    { "type": "text", "id": "chips", "label": "Points forts (séparés par des virgules)" },
    { "type": "text", "id": "cta", "label": "Texte du bouton" }
  ],
  "presets": [{ "name": "Nouveauté" }]
}
{% endschema %}
