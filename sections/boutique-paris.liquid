<div id="boutique" class="sect" style="width: 100%; background: #FBF8F2;">
  <div style="max-width: 1280px; margin: 0 auto;" class="grid-2">

    <!-- Photo de la façade -->
    <div class="boutique-img-wrap ml-reveal">
      {% if section.settings.image %}
        <img
          src="{{ section.settings.image | image_url: width: 1200 }}"
          srcset="{{ section.settings.image | image_url: width: 700 }} 700w, {{ section.settings.image | image_url: width: 1200 }} 1200w"
          sizes="(max-width: 860px) 100vw, 50vw"
          alt="{{ section.settings.image.alt | default: "Façade de la future boutique Maison L'Émeraude à Paris" }}"
          width="1200" height="{{ 1200 | divided_by: section.settings.image.aspect_ratio | round }}"
          loading="lazy"
        >
      {% else %}
        <img
          src="{{ 'boutique-paris.jpg' | asset_url }}"
          srcset="{{ 'boutique-paris-600.jpg' | asset_url }} 600w, {{ 'boutique-paris.jpg' | asset_url }} 1100w"
          sizes="(max-width: 860px) 100vw, 50vw"
          alt="Façade de la future boutique Maison L'Émeraude à Paris, vitrine en travaux avec la bannière « Bientôt à Paris »"
          width="1100" height="1100"
          loading="lazy"
        >
      {% endif %}
      <span class="boutique-badge sans">{{ section.settings.badge | default: "Ouverture prochaine" }}</span>
    </div>

    <!-- Texte -->
    <div style="display: flex; flex-direction: column; gap: 22px;">
      <span class="eyebrow ml-reveal" style="font-size: 10px; color: #7A5C2E; letter-spacing: .28em;">{{ section.settings.eyebrow | default: "La Boutique" }}</span>
      <span class="ornament-grow ml-reveal" style="width: 28px; margin: 0;"></span>
      <h2 class="serif ml-reveal ml-d1" style="margin: 0; font-size: clamp(28px, 4.4vw, 42px); line-height: 1.15; font-weight: 300;">{{ section.settings.headline | default: "Bientôt à Paris." }}</h2>
      <p class="sans ml-reveal ml-d2" style="margin: 0; font-size: 14px; font-weight: 300; line-height: 1.9; color: #4A463D; letter-spacing: .015em; max-width: 480px;">{{ section.settings.body | default: "La Maison prépare sa première adresse. Une boutique pensée comme un écrin, où découvrir nos pièces, les essayer et se laisser conseiller. Les travaux avancent — nous avons hâte de vous y accueillir." }}</p>

      <div class="boutique-details ml-reveal ml-d3">
        <div class="boutique-detail">
          <span class="boutique-detail-label sans">Adresse</span>
          <span class="boutique-detail-value serif">{{ section.settings.address | default: "Paris" }}</span>
        </div>
        <div class="boutique-detail">
          <span class="boutique-detail-label sans">Ouverture</span>
          <span class="boutique-detail-value serif">{{ section.settings.opening | default: "Prochainement" }}</span>
        </div>
      </div>

      <p class="serif ml-reveal ml-d3" style="margin: 4px 0 0; font-size: 16px; font-style: italic; line-height: 1.6; color: #6b6558;">{{ section.settings.note | default: "En attendant, nos bijoux vous attendent ici, en ligne." }}</p>

      <div class="ml-reveal ml-d4" style="display: flex; gap: 22px; align-items: center; flex-wrap: wrap; margin-top: 6px;">
        <a href="#piece" class="btn">Découvrir le bijou</a>
        <a href="#contact" class="u-link sans" style="font-size: 10px; letter-spacing: .18em; text-transform: uppercase;">Être prévenu·e de l'ouverture</a>
      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Boutique — bientôt",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo de la boutique" },
    { "type": "text", "id": "badge", "label": "Pastille sur la photo", "default": "Ouverture prochaine" },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "La Boutique" },
    { "type": "text", "id": "headline", "label": "Titre", "default": "Bientôt à Paris." },
    { "type": "textarea", "id": "body", "label": "Texte" },
    { "type": "text", "id": "address", "label": "Adresse", "default": "Paris" },
    { "type": "text", "id": "opening", "label": "Date d'ouverture", "default": "Prochainement" },
    { "type": "text", "id": "note", "label": "Phrase d'attente" }
  ]
}
{% endschema %}
