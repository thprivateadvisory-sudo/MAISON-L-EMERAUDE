<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">

  <!-- Favicon -->
  <link rel="icon" type="image/png" sizes="192x192" href="{{ 'favicon-192.png' | asset_url }}">
  <link rel="icon" type="image/png" sizes="32x32" href="{{ 'favicon-32.png' | asset_url }}">
  <link rel="apple-touch-icon" sizes="180x180" href="{{ 'apple-touch-icon.png' | asset_url }}">

  <!-- SEO -->
  <title>{{ page_title }}{% unless page_title contains shop.name %} · {{ shop.name }}{% endunless %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  <link rel="canonical" href="{{ canonical_url }}">
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">

  <!-- Open Graph -->
  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:locale" content="fr_FR">
  <meta property="og:type" content="{% if template == 'product' %}product{% else %}website{% endif %}">
  <meta property="og:title" content="{{ page_title | escape }}">
  {% if page_description %}<meta property="og:description" content="{{ page_description | escape }}">{% endif %}
  <meta property="og:url" content="{{ canonical_url }}">
  {% if product.featured_image %}
    <meta property="og:image" content="{{ product.featured_image | image_url: width: 1200 }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
  {% elsif settings.share_image %}
    <meta property="og:image" content="{{ settings.share_image | image_url: width: 1200 }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
  {% endif %}

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@maisonlemeraude">
  <meta name="twitter:title" content="{{ page_title | escape }}">
  {% if page_description %}<meta name="twitter:description" content="{{ page_description | escape }}">{% endif %}
  {% if product.featured_image %}<meta name="twitter:image" content="{{ product.featured_image | image_url: width: 1200 }}">{% elsif settings.share_image %}<meta name="twitter:image" content="{{ settings.share_image | image_url: width: 1200 }}">{% endif %}

  <!-- Schema.org WebSite + Organisation (toutes les pages) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": "{{ shop.url }}/#website",
        "url": {{ shop.url | json }},
        "name": "Maison L'Émeraude",
        "description": "Bijoux fins inspirés de l'émeraude — colliers, pendentifs et pièces signature de la Maison L'Émeraude.",
        "inLanguage": "fr-FR",
        "potentialAction": {
          "@type": "SearchAction",
          "target": {
            "@type": "EntryPoint",
            "urlTemplate": "{{ shop.url }}/search?q={search_term_string}"
          },
          "query-input": "required name=search_term_string"
        }
      },
      {
        "@type": "Organization",
        "@id": "{{ shop.url }}/#organization",
        "name": "Maison L'Émeraude",
        "url": {{ shop.url | json }},
        "logo": {
          "@type": "ImageObject",
          "url": {{ 'logo.png' | asset_url | json }},
          "width": 400,
          "height": 100
        },
        "contactPoint": {
          "@type": "ContactPoint",
          "contactType": "customer service",
          "email": "contact@maisonlemeraude.fr",
          "availableLanguage": "French"
        },
        "sameAs": [
          "https://www.instagram.com/maisonlemeraude",
          "https://www.facebook.com/share/1Sj36e8w4h/"
        ]
      }
    ]
  }
  </script>

  <!-- Schema.org Product (page produit) -->
  {% if template == 'product' %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "Product",
    "@id": {{ request.origin | append: product.url | append: '#product' | json }},
    "name": {{ product.title | json }},
    "description": {{ product.description | strip_html | strip_newlines | json }},
    "url": {{ request.origin | append: product.url | json }},
    {% if product.featured_image %}
    "image": [
      {{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }}{% for img in product.images %}{% unless forloop.first == true and product.images.size == 1 %},
      {{ img | image_url: width: 1200 | prepend: 'https:' | json }}{% endunless %}{% endfor %}
    ],
    {% endif %}
    "sku": {{ product.selected_or_first_available_variant.sku | json }},
    "brand": {
      "@type": "Brand",
      "name": "Maison L'Émeraude"
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.9",
      "reviewCount": "47",
      "bestRating": "5",
      "worstRating": "1"
    },
    "offers": {
      "@type": "Offer",
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "price": {{ product.price | divided_by: 100.0 | json }},
      "availability": {% if product.available %}"https://schema.org/InStock"{% else %}"https://schema.org/OutOfStock"{% endif %},
      "url": {{ request.origin | append: product.url | json }},
      "seller": {
        "@type": "Organization",
        "name": "Maison L'Émeraude"
      },
      "shippingDetails": {
        "@type": "OfferShippingDetails",
        "shippingRate": {
          "@type": "MonetaryAmount",
          "value": "0",
          "currency": "EUR"
        },
        "deliveryTime": {
          "@type": "ShippingDeliveryTime",
          "handlingTime": {
            "@type": "QuantitativeValue",
            "minValue": 1,
            "maxValue": 2,
            "unitCode": "DAY"
          },
          "transitTime": {
            "@type": "QuantitativeValue",
            "minValue": 3,
            "maxValue": 7,
            "unitCode": "DAY"
          }
        },
        "shippingDestination": {
          "@type": "DefinedRegion",
          "addressCountry": "FR"
        }
      },
      "hasMerchantReturnPolicy": {
        "@type": "MerchantReturnPolicy",
        "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
        "merchantReturnDays": 30,
        "returnMethod": "https://schema.org/ReturnByMail",
        "returnFees": "https://schema.org/FreeReturn"
      }
    }
  }
  </script>
  {% endif %}

  <!-- Schema.org BreadcrumbList -->
  {% if template == 'product' %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Accueil",
        "item": {{ shop.url | json }}
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ product.title | json }},
        "item": {{ request.origin | append: product.url | json }}
      }
    ]
  }
  </script>
  {% endif %}

  <!-- Fonts -->
  <link rel="dns-prefetch" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&family=Montserrat:wght@300;400;500&display=swap">
  <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">

  <!-- Preload image héro pour Core Web Vitals -->
  {% if template == 'index' %}
  <link rel="preload" as="image" href="{{ 'paris.jpg' | asset_url }}" fetchpriority="high">
  {% endif %}
  {% if template == 'product' and product.featured_image %}
  <link rel="preload" as="image" href="{{ product.featured_image | image_url: width: 1000 }}" fetchpriority="high">
  {% endif %}

  {{ content_for_header }}
</head>
<body>
  {% sections 'header-group' %}
  <main id="MainContent">
    {{ content_for_layout }}
  </main>
  {% sections 'footer-group' %}

  <noscript><style>.ml-reveal,.ornament-grow{opacity:1!important;transform:none!important;}</style></noscript>
  <script>
  (function(){
    if(!('IntersectionObserver' in window)){
      document.querySelectorAll('.ml-reveal,.ornament-grow').forEach(function(el){el.classList.add('ml-visible');});
      return;
    }
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting){ e.target.classList.add('ml-visible'); io.unobserve(e.target); }
      });
    },{threshold:0.08, rootMargin:'0px 0px -28px 0px'});
    function scan(){
      document.querySelectorAll('.ml-reveal,.ornament-grow').forEach(function(el){ io.observe(el); });
    }
    if(document.readyState==='loading'){ document.addEventListener('DOMContentLoaded',scan); } else { scan(); }
  })();
  </script>
</body>
</html>
