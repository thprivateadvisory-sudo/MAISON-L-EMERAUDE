<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">

  <!-- Favicon -->
  <link rel="icon" type="image/png" sizes="192x192" href="{{ 'favicon-192.png' | asset_url }}">
  <link rel="icon" type="image/png" sizes="32x32" href="{{ 'favicon-32.png' | asset_url }}">
  <link rel="apple-touch-icon" sizes="180x180" href="{{ 'apple-touch-icon.png' | asset_url }}">

  <!-- SEO -->
  <title>{{ page_title }}{% unless page_title contains shop.name %} · {{ shop.name }}{% endunless %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  <link rel="canonical" href="{{ canonical_url }}">
  {% if template.name == 'cart' or template.name == 'search' or template.name == '404' %}
    <meta name="robots" content="noindex, follow">
  {% else %}
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
  {% endif %}

  <!-- Open Graph -->
  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:locale" content="fr_FR">
  <meta property="og:type" content="{% if template == 'product' %}product{% else %}website{% endif %}">
  <meta property="og:title" content="{{ page_title | escape }}">
  {% if page_description %}<meta property="og:description" content="{{ page_description | escape }}">{% endif %}
  <meta property="og:url" content="{{ canonical_url }}">
  {%- liquid
    if template.name == 'product' and product.featured_image
      assign og_image = product.featured_image
    elsif settings.share_image != blank
      assign og_image = settings.share_image
    endif
  -%}
  {% if og_image %}
    <meta property="og:image" content="https:{{ og_image | image_url: width: 1200 }}">
    <meta property="og:image:secure_url" content="https:{{ og_image | image_url: width: 1200 }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="{{ 1200 | divided_by: og_image.aspect_ratio | round }}">
    <meta property="og:image:alt" content="{{ og_image.alt | default: page_title | escape }}">
  {% endif %}

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  {% if settings.twitter_handle != blank %}<meta name="twitter:site" content="@{{ settings.twitter_handle | remove: '@' }}">{% endif %}
  <meta name="twitter:title" content="{{ page_title | escape }}">
  {% if page_description %}<meta name="twitter:description" content="{{ page_description | escape }}">{% endif %}
  {% if og_image %}<meta name="twitter:image" content="https:{{ og_image | image_url: width: 1200 }}">{% endif %}

  <!-- Schema.org WebSite + Organisation (toutes les pages) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": "{{ shop.url }}/#website",
        "url": {{ shop.url | json }},
        "name": "Maison L'Émeraude",
        "description": "Bijoux fins inspirés de l'émeraude — colliers, pendentifs et pièces signature de la Maison L'Émeraude.",
        "inLanguage": "fr-FR",
        "potentialAction": {
          "@type": "SearchAction",
          "target": {
            "@type": "EntryPoint",
            "urlTemplate": "{{ shop.url }}/search?q={search_term_string}"
          },
          "query-input": "required name=search_term_string"
        }
      },
      {
        "@type": "Organization",
        "@id": "{{ shop.url }}/#organization",
        "name": "Maison L'Émeraude",
        "url": {{ shop.url | json }},
        "logo": {
          "@type": "ImageObject",
          "url": {{ 'logo.png' | asset_url | prepend: 'https:' | json }},
          "width": 360,
          "height": 110
        },
        "contactPoint": {
          "@type": "ContactPoint",
          "contactType": "customer service",
          "email": {{ settings.contact_email | default: 'contact@maisonlemeraude.fr' | json }},
          "availableLanguage": "French"
        },
        "sameAs": [
          "https://www.instagram.com/maisonlemeraude",
          "https://www.facebook.com/share/1Sj36e8w4h/"
        ]
      }
    ]
  }
  </script>

  <!-- Schema.org Product (page produit) -->
  {% if template == 'product' %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "Product",
    "@id": {{ request.origin | append: product.url | append: '#product' | json }},
    "name": {{ product.title | json }},
    "description": {{ product.description | strip_html | strip_newlines | json }},
    "url": {{ request.origin | append: product.url | json }},
    {% if product.images.size > 0 %}
    "image": [
      {%- for img in product.images -%}
      {{ img | image_url: width: 1200 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}
      {%- endfor %}
    ],
    {% endif %}
    "sku": {{ product.selected_or_first_available_variant.sku | json }},
    "brand": {
      "@type": "Brand",
      "name": "Maison L'Émeraude"
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.9",
      "reviewCount": "47",
      "bestRating": "5",
      "worstRating": "1"
    },
    "offers": {
      "@type": "Offer",
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "price": {{ product.price | divided_by: 100.0 | json }},
      "availability": {% if product.available %}"https://schema.org/InStock"{% else %}"https://schema.org/OutOfStock"{% endif %},
      "url": {{ request.origin | append: product.url | json }},
      "seller": {
        "@type": "Organization",
        "name": "Maison L'Émeraude"
      },
      {%- if settings.free_shipping %}
      "shippingDetails": {
        "@type": "OfferShippingDetails",
        "shippingRate": {
          "@type": "MonetaryAmount",
          "value": "0",
          "currency": "EUR"
        },
        "deliveryTime": {
          "@type": "ShippingDeliveryTime",
          "handlingTime": {
            "@type": "QuantitativeValue",
            "minValue": 1,
            "maxValue": 2,
            "unitCode": "DAY"
          },
          "transitTime": {
            "@type": "QuantitativeValue",
            "minValue": 3,
            "maxValue": 7,
            "unitCode": "DAY"
          }
        },
        "shippingDestination": {
          "@type": "DefinedRegion",
          "addressCountry": "FR"
        }
      },
      {%- endif %}
      "hasMerchantReturnPolicy": {
        "@type": "MerchantReturnPolicy",
        "applicableCountry": "FR",
        "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
        "merchantReturnDays": {{ settings.return_days | default: 30 }},
        "returnMethod": "https://schema.org/ReturnByMail",
        "returnFees": {% if settings.free_returns %}"https://schema.org/FreeReturn"{% else %}"https://schema.org/ReturnFeesCustomerResponsibility"{% endif %}
      }
    }
  }
  </script>
  {% endif %}

  <!-- Schema.org BreadcrumbList -->
  {% if template == 'product' %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Accueil",
        "item": {{ shop.url | json }}
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ product.title | json }},
        "item": {{ request.origin | append: product.url | json }}
      }
    ]
  }
  </script>
  {% endif %}

  <!-- Polices auto-hébergées (pas d'appel à Google Fonts : RGPD + performance) -->
  {{ 'montserrat.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
  {{ 'cormorant-garamond.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
  <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">

  <!-- Preload image héro pour Core Web Vitals -->
  {% if template == 'index' %}
  <link rel="preload" as="image" href="{{ 'paris.jpg' | asset_url }}" imagesrcset="{{ 'paris-600.jpg' | asset_url }} 600w, {{ 'paris.jpg' | asset_url }} 1145w" imagesizes="100vw" fetchpriority="high">
  {% endif %}
  {% if template == 'product' and product.featured_image %}
  <link rel="preload" as="image" href="{{ product.featured_image | image_url: width: 1000 }}" imagesrcset="{{ product.featured_image | image_url: width: 600 }} 600w, {{ product.featured_image | image_url: width: 1000 }} 1000w" imagesizes="(max-width: 860px) 100vw, 50vw" fetchpriority="high">
  {% endif %}

  {{ content_for_header }}
</head>
<body class="template-{{ template.name }}">
  <a class="skip-link" href="#MainContent">Aller au contenu</a>
  {% sections 'header-group' %}
  <main id="MainContent" tabindex="-1">
    {{ content_for_layout }}
  </main>
  {% sections 'footer-group' %}

  <noscript><style>.ml-reveal,.ornament-grow{opacity:1!important;transform:none!important;}</style></noscript>
  <script>
  (function(){
    if(!('IntersectionObserver' in window)){
      document.querySelectorAll('.ml-reveal,.ornament-grow').forEach(function(el){el.classList.add('ml-visible');});
      return;
    }
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting){ e.target.classList.add('ml-visible'); io.unobserve(e.target); }
      });
    },{threshold:0.08, rootMargin:'0px 0px -28px 0px'});
    function scan(){
      document.querySelectorAll('.ml-reveal,.ornament-grow').forEach(function(el){ io.observe(el); });
    }
    if(document.readyState==='loading'){ document.addEventListener('DOMContentLoaded',scan); } else { scan(); }
  })();
  </script>
</body>
</html>
